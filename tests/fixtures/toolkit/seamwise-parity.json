          "id": "B-1",
          "then": "the override and its provenance are returned",
          "when": "effective policy is resolved"
        },
        {
          "given": "no organization override",
          "id": "B-2",
          "then": "the validated default and its provenance are returned",
          "when": "effective policy is resolved"
        }
      ],
      "evals": [
        {
          "command": "pytest -q tests/test_policy_resolution.py -k override",
