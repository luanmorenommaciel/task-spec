    {
      "id": "T-20260802-request-101",
      "title": "Enforce the effective limit at request 101",
      "goal": "Apply one effective policy at the request boundary without off-by-one drift.",
      "effort": "S",
      "profile": "standard",
      "agent": "any",
      "execution_backend": "any",
      "depends_on": [
