          "terminal": false,
          "verifies": [
            "B-1"
          ]
        },
        {
          "command": "pytest -q tests/test_policy_resolution.py -k default",
          "description": "Defaults resolve when no override exists",
          "expected_duration_sec": 10,
          "id": "eval_2",
          "terminal": false,
          "verifies": [
            "B-2"
          ]
        },
        {
          "command": "pytest -q tests/test_policy_resolution.py -k provenance",
          "description": "Resolution returns policy provenance",
          "expected_duration_sec": 10,
          "id": "eval_3",
          "terminal": true,
          "verifies": [
            "B-1",
            "B-2"
          ]
        }
      ],
      "required_tools": [
        "git",
        "bash",
        "python3",
        "pytest"
      ],
      "rollback": "Remove the additive resolver and focused tests.",
      "observability": "effective policy resolution test pass count"
    },
