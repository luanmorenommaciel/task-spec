      ],
      "behaviors": [
        {
          "given": "an effective limit of 100 and count 99",
          "id": "B-1",
          "then": "the request is allowed",
          "when": "request 100 is evaluated"
        },
        {
          "given": "an effective limit of 100 and count 100",
          "id": "B-2",
          "then": "the request is denied exactly once",
          "when": "request 101 is evaluated"
