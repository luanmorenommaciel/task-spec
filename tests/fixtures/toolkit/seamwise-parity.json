    {
      "id": "T-20260802-decision-visibility",
      "title": "Expose the denial reason and decision telemetry",
      "goal": "Make the request 101 decision explainable without turning telemetry into authority.",
      "effort": "S",
      "profile": "standard",
      "agent": "any",
      "execution_backend": "any",
      "depends_on": [
        "T-20260802-request-101"
      ],
      "touches_paths": [],
      "creates_paths": [
        "src/rate_limit/decision.py",
        "tests/test_decision_visibility.py"
      ],
      "behaviors": [
        {
          "given": "request 101 is denied",
          "id": "B-1",
          "then": "it exposes the stable reason organization_rate_limit_exceeded",
          "when": "the response is created"
        },
        {
          "given": "the same denial decision",
          "id": "B-2",
          "then": "it carries the same reason and decision identifier",
          "when": "telemetry is emitted"
        }
      ],
      "evals": [
        {
          "command": "pytest -q tests/test_decision_visibility.py -k response_reason",
          "description": "The response exposes the stable denial reason",
          "expected_duration_sec": 10,
          "id": "eval_1",
          "terminal": false,
          "verifies": [
            "B-1"
          ]
        },
        {
          "command": "pytest -q tests/test_decision_visibility.py -k telemetry_reason",
          "description": "Telemetry carries the matching reason",
          "expected_duration_sec": 10,
          "id": "eval_2",
          "terminal": false,
          "verifies": [
            "B-2"
          ]
        },
        {
          "command": "pytest -q tests/test_decision_visibility.py -k decision_identifier",
          "description": "Response and telemetry share a decision identifier",
          "expected_duration_sec": 10,
          "id": "eval_3",
          "terminal": true,
          "verifies": [
            "B-1",
            "B-2"
          ]
        }
      ],
      "required_tools": [
        "git",
        "bash",
        "python3",
        "pytest"
      ],
      "rollback": "Remove the additive response adapter, telemetry event, and focused tests.",
      "observability": "response-to-telemetry correlation test pass count"
    },
    {
      "id": "T-20260802-effective-policy",
      "title": "Resolve one effective organization policy",
