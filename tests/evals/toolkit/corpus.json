    {"id": "contention", "outcome": "Deliver disjoint file changes sharing an exclusive environment resource", "required_evidence": ["resource declaration", "serialized leases", "no overlap", "acceptance"]},
    {"id": "incident", "outcome": "Turn an external observation into reviewed corrective work", "required_evidence": ["reported observation", "candidate intent", "diagnosis", "accepted successor"]},
    {"id": "release-evidence", "outcome": "Establish release readiness without equating pipeline status with target health", "required_evidence": ["revision", "artifact", "environment", "pipeline run", "independent target observation", "human release decision"]}
