  "required_inputs": ["repository snapshots", "matched budgets", "permission manifests", "independent evaluator definitions", "engineer active-time observations"],
  "release_requires": ["no false acceptance", "acceptance quality nonregression", "one median time improves without worsening the other", "all workflow results including unfavorable results retained", "migration and rollback demonstrated"]
}
