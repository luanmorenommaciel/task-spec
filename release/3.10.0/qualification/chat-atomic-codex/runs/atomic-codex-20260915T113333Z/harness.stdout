{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nfrom pathlib import Path\nimport json\nimport re\nimport subprocess\nimport tempfile\n\nroot = Path.cwd()\npath = root / 'tasks/T-20260915-policy-schema.md'\ntext = path.read_text()\nblocks = re.findall(r'\"'```bash'\"\\\\n(.*?)\"'```'\"', text, re.S)\nassert len(blocks) == 2\nfunctions, exit_check = blocks\nsyntax = subprocess.run(['bash', '-n'], input=functions + '\\\\n' + exit_check, text=True, capture_output=True)\nassert syntax.returncode == 0, syntax.stderr\nfor i in (1, 2, 3):\n    source = re.search(rf\\\"<<'PY_EVAL_{i}'\\\\n(.*?)\\\\nPY_EVAL_{i}\\\", functions, re.S).group(1)\n    compile(source, f'eval_{i}', 'exec')\n\n# All scratch paths are beneath this repository; only temporary controls are created.\n# These are deliberately incorrect validators, never a proposed implementation.\ncontrols = {\n    'missing_implementation': None,\n    'accept_everything': 'def validate_policy(policy):\\\\n    return policy\\\\n',\n    'reject_everything': 'def validate_policy(policy):\\\\n    raise ValueError(\\\"test control\\\")\\\\n',\n    'no_op': 'def validate_policy(policy):\\\\n    pass\\\\n',\n}\nexpected = {\n    'missing_implementation': [1, 1, 1],\n    'accept_everything': [0, 1, 1],\n    'reject_everything': [1, 0, 0],\n    'no_op': [1, 1, 1],\n}\nresults = {}\nwith tempfile.TemporaryDirectory(prefix='.policy-schema-eval-', dir=root / 'tasks') as scratch:\n    scratch = Path(scratch)\n    target = scratch / 'tests/fixtures/toolkit/policy_schema.py'\n    target.parent.mkdir(parents=True)\n    for name, stub in controls.items():\n        if stub is not None:\n            target.write_text(stub)\n        codes = []\n        for i in (1, 2, 3):\n            run = subprocess.run(['bash', '-c', functions + f'\\\\neval_{i}\\\\n'], cwd=scratch,\n                                 text=True, capture_output=True, timeout=10)\n            codes.append(run.returncode)\n            if run.returncode:\n                assert 'AssertionError:' in run.stderr, (name, i, run.stderr)\n        assert codes == expected[name], (name, codes)\n        combined = subprocess.run(['bash', '-c', functions + '\\\\n' + exit_check], cwd=scratch,\n                                 text=True, capture_output=True, timeout=10)\n        assert combined.returncode == 1, (name, combined.stderr)\n        results[name] = {'eval_exit_codes': codes, 'exit_check': combined.returncode}\nassert not (root / 'tests/fixtures/toolkit/policy_schema.py').exists()\nreport = {\n    'task': path.name,\n    'purpose': 'Authoring-only evaluation discrimination; not authorization or acceptance evidence.',\n    'bash_syntax': 'pass',\n    'python_syntax': 'pass',\n    'controls': results,\n    'scratch_removed': not scratch.exists(),\n    'limitation': 'No implementation or conforming positive control was authored; passing implementation behavior remains unproven.'\n}\nreport_path = root / 'tasks/reviews/policy-schema-eval-review.json'\nreport_path.parent.mkdir(exist_ok=True)\nreport_path.write_text(json.dumps(report, indent=2) + '\\\\n')\nprint(json.dumps(report, indent=2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
