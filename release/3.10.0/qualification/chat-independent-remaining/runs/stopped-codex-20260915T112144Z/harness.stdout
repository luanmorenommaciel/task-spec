{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/zsh -lc \"python3 - <<'PY'\nimport sqlite3\ncon=sqlite3.connect('file:.taskspec/mesh/mesh.db?mode=ro', uri=True)\nfor name,sql in con.execute(\\\"SELECT name, sql FROM sqlite_master WHERE type='table'\\\"):\n    print(name,sql)\nPY\"","aggregated_output":"commands CREATE TABLE commands (\n            request_id TEXT PRIMARY KEY,\n            command TEXT NOT NULL,\n            response_json TEXT NOT NULL,\n            created_at TEXT NOT NULL\n        )\nevents CREATE TABLE events (\n            sequence INTEGER PRIMARY KEY AUTOINCREMENT,\n            event_id TEXT NOT NULL UNIQUE,\n            request_id TEXT NOT NULL,\n            run_id TEXT,\n            attempt_id TEXT,\n            fencing_token INTEGER,\n            event_type TEXT NOT NULL,\n            observed_at TEXT NOT NULL,\n            payload_json TEXT NOT NULL,\n            payload_digest TEXT NOT NULL\n\t\t)\nsqlite_sequence CREATE TABLE sqlite_sequence(name,seq)\nrecipe_budgets CREATE TABLE recipe_budgets (\n            task_id TEXT NOT NULL, revision TEXT NOT NULL, used INTEGER NOT NULL,\n            deadline TEXT NOT NULL, no_progress INTEGER NOT NULL,\n            last_fingerprint TEXT NOT NULL, PRIMARY KEY(task_id, revision)\n        )\nmetadata CREATE TABLE metadata (key TEXT PRIMARY KEY, value TEXT NOT NULL)\nruns CREATE TABLE runs (\n            run_id TEXT PRIMARY KEY,\n            graph_revision_digest TEXT NOT NULL,\n            target_branch TEXT NOT NULL,\n            target_commit TEXT NOT NULL,\n            integration_branch TEXT NOT NULL,\n            mode TEXT NOT NULL,\n            max_parallel INTEGER NOT NULL,\n            state TEXT NOT NULL,\n            created_at TEXT NOT NULL,\n            integration_workspace TEXT\n        , finished_at TEXT)\nleases CREATE TABLE leases (\n            attempt_id TEXT PRIMARY KEY,\n            run_id TEXT NOT NULL REFERENCES runs(run_id),\n            task_id TEXT NOT NULL,\n            task_revision_digest TEXT NOT NULL,\n            fencing_token INTEGER NOT NULL,\n            owner TEXT NOT NULL,\n            issued_at TEXT NOT NULL,\n            expires_at TEXT NOT NULL,\n            heartbeat_at TEXT NOT NULL,\n            state TEXT NOT NULL,\n            adapter TEXT,\n            branch TEXT,\n            workspace TEXT,\n            decision_json TEXT,\n            acceptance_record TEXT\n        , model TEXT, provider TEXT)\nlease_claims CREATE TABLE lease_claims (\n            attempt_id TEXT NOT NULL REFERENCES leases(attempt_id),\n            kind TEXT NOT NULL, value TEXT NOT NULL,\n            PRIMARY KEY(attempt_id, kind, value)\n        )\nlease_fences CREATE TABLE lease_fences (\n            task_revision_digest TEXT PRIMARY KEY,\n            token INTEGER NOT NULL\n        )\ncredential_leases CREATE TABLE credential_leases (\n            lease_id TEXT PRIMARY KEY,\n            attempt_id TEXT NOT NULL REFERENCES leases(attempt_id),\n            provider TEXT NOT NULL,\n            model TEXT NOT NULL,\n            audience TEXT NOT NULL,\n            scopes_json TEXT NOT NULL,\n            issued_at TEXT NOT NULL,\n            expires_at TEXT NOT NULL,\n            state TEXT NOT NULL,\n            broker_ref TEXT\n        )\n","exit_code":0,"status":"completed"}}
