archive to the selected destination\"\n    },\n    \"metrics\": {\n      \"mutation\": \"none\",\n      \"tokens\": [],\n      \"usage\": \"Usage: taskspec metrics [--since YYYY-MM-DD] [--author <name>] [--status <status>]\",\n      \"flags\": [\n        \"--author\",\n        \"--since\",\n        \"--status\"\n      ],\n      \"summary\": \"none\"\n    },\n    \"conformance\": {\n      \"mutation\": \"self-test uses disposable fixtures only\",\n      \"tokens\": [],\n      \"usage\": \"Usage: taskspec conformance --self-test | --level L0|L1|L2 --executor <command>\",\n      \"flags\": [\n        \"--executor\",\n        \"--level\",\n        \"--self-test\"\n      ],\n      \"summary\": \"self-test uses disposable fixtures only\"\n    },\n    \"executor\": {\n      \"mutation\": \"reference L2 executor; transitions, executes, accepts, or parks one supplied task\",\n      \"tokens\": [],\n      \"usage\": \"Usage: taskspec executor <task-spec>\",\n      \"flags\": [],\n      \"summary\": \"reference L2 executor; transitions, executes, accepts, or parks one supplied task\"\n    },\n    \"agent-context\": {\n      \"mutation\": \"none\",\n      \"tokens\": [],\n      \"usage\": \"Usage: taskspec agent-context\",\n      \"flags\": [],\n      \"summary\": \"none\"\n    },\n    \"completion\": {\n      \"mutation\": \"none\",\n      \"tokens\": [],\n      \"usage\": \"Usage: taskspec completion bash|zsh|fish\",\n      \"flags\": [],\n      \"summary\": \"none\"\n    },\n    \"doctor\": {\n      \"mutation\": \"none\",\n      \"tokens\": [\n        \"BACKLOG_DOCTOR=READY\",\n        \"BACKLOG_DOCTOR=BLOCKED\",\n        \"DOCTOR=READY\",\n        \"DOCTOR=BLOCKED\"\n      ],\n      \"usage\": \"Usage: taskspec doctor [--backlog]\",\n      \"flags\": [\n        \"--backlog\"\n      ],\n      \"summary\": \"none\"\n    },\n    \"version\": {\n      \"mutation\": \"none\",\n      \"tokens\": [],\n      \"usage\": \"Usage: taskspec version\",\n      \"flags\": [],\n      \"su