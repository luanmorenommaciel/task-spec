{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc 'bash \"/private/tmp/taskspec-chat-qualified-engines/3.10.0/bin/taskspec\" help decompose && cat .agents/skills/task-spec/references/schemas/decompose-recipe.schema.json .taskspec/config'","aggregated_output":"{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://taskspec.dev/schemas/decompose-recipe.schema.json\",\n  \"title\": \"TaskSpec native authored compilation recipe v1\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\n    \"schema_version\",\n    \"intent\",\n    \"system_map\",\n    \"evidence\",\n    \"seams\",\n    \"steel_thread\"\n  ],\n  \"$defs\": {\n    \"identifier\": {\n      \"type\": \"string\",\n      \"pattern\": \"^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$\"\n    },\n    \"claim\": {\n      \"enum\": [\n        \"current\",\n        \"proposed\",\n        \"derived\",\n        \"external\"\n      ]\n    },\n    \"source\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\n        \"uri\",\n        \"captured_at\",\n        \"sha256\"\n      ],\n      \"properties\": {\n        \"uri\": {\n          \"type\": \"string\",\n          \"minLength\": 1,\n          \"anyOf\": [\n            {\n              \"format\": \"uri\",\n              \"pattern\": \"^[A-Za-z][A-Za-z0-9+.-]*:\"\n            },\n            {\n              \"pattern\": \"^(?!/)(?!.*(?:^|/)\\\\.\\\\.?(?:/|$))(?!.*\\\\\\\\)(?!.*\\\\s)(?!.*//)[^/]+(?:/[^/]+)*$\"\n            }\n          ]\n        },\n        \"captured_at\": {\n          \"type\": \"string\",\n          \"format\": \"date-time\"\n        },\n        \"sha256\": {\n          \"type\": \"string\",\n          \"pattern\": \"^[a-f0-9]{64}$\"\n        }\n      }\n    },\n    \"evidence\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\n        \"id\",\n        \"claim\",