{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,150p' /private/tmp/taskspec-chat-qualified-engines/3.10.0/src/decompose/engine/planning.py && rg -n 'def prepare|def init|proposed-graph|OPEN_OBJECTIONS' /private/tmp/taskspec-chat-qualified-engines/3.10.0/src/decompose/cli.py /private/tmp/taskspec-chat-qualified-engines/3.10.0/src/decompose/engine/*.py\"","aggregated_output":"\"\"\"Delivery-plan construction, human review acceptance, and verification.\"\"\"\n\nfrom __future__ import annotations\n\nfrom decompose.paths import PLAN_DIR\nfrom decompose.auth import sign, verify, reviewed_inputs\n\nimport datetime as dt\nfrom pathlib import Path\nfrom typing import Any\n\nimport yaml\n\nfrom decompose.constants import (\n    EXIT_CONFLICT,\n    EXIT_INVALID,\n    EXIT_NEEDS_INPUT,\n    EXIT_OK,\n    PLAN_ERROR,\n    PLAN_NEEDS_DECISION,\n    PLAN_NEEDS_OWNER,\n    PLAN_NEEDS_REVIEW,\n    PLAN_OPEN_OBJECTIONS,\n    PLAN_READY,\n)\nfrom decompose.contracts import validate_contract\nfrom decompose.engine.seams import _owned_artifact_path, verify_seam_map\nfrom decompose.engine.support import _diag, _event\nfrom decompose.io import (\n    TransactionWriter,\n    UnsafeWriteTargetError,\n    canonical_json,\n    load_frontmatter,\n    load_json,\n    load_yaml,\n    sha256_bytes,\n    sha256_file,\n    workspace_lock,\n)\nfrom decompose.render import (\n    render_leg,\n    render_steel_thread,\n    render_swimlane,\n)\nfrom decompose.result import Diagnostic, Result\nfrom decompose.safety import workspace_boundary_diagnostics\n\n\ndef build_plan(root: Path, *, dry_run: bool = False) -> Result:\n    boundary_diagnostics = workspace_boundary_diagnostics(root)\n    if boundary_diagnostics:\n        return Result(\"plan\", PLAN_ERROR, EXIT_CONFLICT, root, diagnostics=boundary_diagnostics)\n    seam_map_path = root / PLAN_DIR / \"seam-map.yaml\"\n    seam_map, seam_diagnostics = verify_seam_map(root)\n    if seam_map is None:\n        exit_code = (\n            EXIT_NEEDS_INPUT\n            if any(\n                item.code in {\"seam_map_missing\", \"seam_map_not_ready\"} for item in seam_diagnostics\n            )\n            else EXIT_CONFLICT\n        )\n        return Result(\n            \"plan\",\n            PLAN_NEEDS_DECISION,\n            exit_code,\n            root,\n            diagnostics=seam_diagnostics,\n            next_steps=['taskspec decompose prepare <initiative> --recipe \"/path/to/recipe.yaml\"'],\n        )\n    system_path = root / PLAN_DIR / \"system-map.md\"\n    try:\n        system, _ = load_frontmatter(system_path)\n    except (OSError, ValueError) as error:\n        return Result(\n            \"plan\",\n            PLAN_NEEDS_DECISION,\n            EXIT_INVALID,\n            root,\n            diagnostics=[_diag(\"system_map_invalid\", str(error), system_path)],\n        )\n    unknowns = system.get(\"unknowns\", [])\n    if unknowns:\n        return Result(\n            \"plan\",\n            PLAN_NEEDS_DECISION,\n            EXIT_NEEDS_INPUT,\n            root,\n            diagnostics=[\n                _diag(\n                    \"architecture_unknown_open\",\n                    \"The authored system map contains unresolved architecture unknowns.\",\n                    system_path,\n                    unknowns=unknowns,\n                )\n            ],\n            next_steps=[\n                \"Resolve every material unknown in sourced evidence, then map the revised recipe in a clean workspace.\"\n            ],\n        )\n    objections = system.get(\"objections\", [])\n    for objection in objections:\n        if objection.get(\"status\") in {\"ACCEPTED\", \"FIXED\"} and not (\n            str(objection.get(\"owner\", \"\")).strip() and str(objection.get(\"rationale\", \"\")).strip()\n        ):\n            return Result(\n                \"plan\",\n                PLAN_NEEDS_OWNER,\n                EXIT_NEEDS_INPUT,\n                root,\n                diagnostics=[\n                    _diag(\n                        \"accepted_objection_incomplete\",\n                        f\"Objection {objection.get('id')} needs owner and rationale.\",\n                    )\n                ],\n            )\n    token = (\n        PLAN_OPEN_OBJECTIONS\n        if any(item.get(\"status\") == \"OPEN\" for item in objections)\n        else PLAN_NEEDS_REVIEW\n    )\n    exit_code = EXIT_NEEDS_INPUT\n    writer = TransactionWriter(dry_run=dry_run)\n    lane_index: list[dict[str, Any]] = []\n    leg_index: list[dict[str, Any]] = []\n    with workspace_lock(root, dry_run=dry_run):\n        locked_map, locked_diagnostics = verify_seam_map(root)\n        if locked_map is None or locked_map != seam_map:\n            return Result(\n                \"plan\",\n                PLAN_NEEDS_DECISION,\n                EXIT_CONFLICT,\n                root,\n                diagnostics=locked_diagnostics\n                or [_diag(\"seam_map_changed\", \"Seam map changed while planning.\")],\n            )\n        generated_files: dict[Path, str] = {}\n        for seam_record in seam_map[\"seams\"]:\n            seam_path = root / seam_record[\"path\"]\n            seam, _ = load_frontmatter(seam_path)\n            lane = seam[\"swimlane\"]\n            lane_path = root / PLAN_DIR / \"swimlanes\" / f\"{lane['id']}.md\"\n            lane_content = render_swimlane(lane, seam[\"id\"], seam_record[\"sha256\"])\n            writer.text(lane_path, lane_content)\n            generated_files[lane_path] = lane_content\n            lane_index.append(\n                {\n                    \"id\": lane[\"id\"],\n                    \"seam_id\": seam[\"id\"],\n/private/tmp/taskspec-chat-qualified-engines/3.10.0/src/decompose/engine/planning.py:23:    PLAN_OPEN_OBJECTIONS,\n/private/tmp/taskspec-chat-qualified-engines/3.10.0/src/decompose/engine/planning.py:119:        PLAN_OPEN_OBJECTIONS\n/private/tmp/taskspec-chat-qualified-engines/3.10.0/src/decompose/engine/planning.py:265:        if token == PLAN_OPEN_OBJECTIONS\n/private/tmp/taskspec-chat-qualified-engines/3.10.0/src/decompose/engine/planning.py:313:    if plan.get(\"status\") == PLAN_OPEN_OBJECTIONS or any(\n/private/tmp/taskspec-chat-qualified-engines/3.10.0/src/decompose/engine/planning.py:318:            PLAN_OPEN_OBJECTIONS,\n/private/tmp/taskspec-chat-qualified-engines/3.10.0/src/decompose/engine/planning.py:345:        \"topology_sha256\": sha256_file(root / PLAN_DIR / \"proposed-graph.json\"),\n/private/tmp/taskspec-chat-qualified-engines/3.10.0/src/decompose/engine/planning.py:552:                if isinstance(receipt, dict) and (receipt.get(\"topology_sha256\") != sha256_file(root / PLAN_DIR / \"proposed-graph.json\") or receipt.get(\"recipe_sha256\") != sha256_file(root / PLAN_DIR / \"source-recipe.yaml\")):\n/private/tmp/taskspec-chat-qualified-engines/3.10.0/src/decompose/cli.py:57:def prepare(root: Path, initiative: str, source: Path, replace: bool, dry: bool) -> dict:\n/private/tmp/taskspec-chat-qualified-engines/3.10.0/src/decompose/cli.py:125:        (staged / PLAN_DIR / \"proposed-graph.json\").write_text(json.dumps(graph, indent=2) + \"\\n\")\n/private/tmp/taskspec-chat-qualified-engines/3.10.0/src/decompose/cli.py:239:            if errors or graph != load_json(folder / \"proposed-graph.json\"):\n","exit_code":0,"status":"completed"}}
