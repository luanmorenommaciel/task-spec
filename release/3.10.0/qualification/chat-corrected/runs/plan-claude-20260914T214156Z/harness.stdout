{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SEtGTtbvFF7w8gEBJyns63","type":"tool_result","content":"EXAMPLE=WRITTEN example=recipe path=/private/tmp/ts-recipe-example.yaml action=created digest=sha256:62f535119aa7ff2cc5715360a93eaba8e09ead73c71594a6a10d4e03b4296dbf\n=== INTENT EXAMPLE ===\n# Candidate intent\n\nOutcome: restore successful checkout requests.\n\nEvidence: attach incident source, revision, observation time, and reproduction.\n\nConstraints: preserve the current public API; do not deploy until release authorization.\n\nOwner: record the responsible product owner.\n\nUnknowns: determine the evidenced cause before proposing a repair.\n=== RECIPE EXAMPLE ===\n{\n  \"contract\": \"TaskExecutionRecipe/v1\",\n  \"strategy\": \"diagnose-repair-verify\",\n  \"strategy_version\": \"1.0.0\",\n  \"steps\": [\n    \"Reproduce the failure and gather evidence before choosing a cause.\",\n    \"Repair the evidenced cause within scope.\",\n    \"Verify the reproduction and affected regression checks.\"\n  ],\n  \"context\": [\n    \"TaskHandoff\",\n    \"authorized Task-Spec\",\n    \"declared source evidence\"\n  ],\n  \"artifacts\": [\n    \"scoped changes\",\n    \"evaluation evidence\",\n    \"concise result\"\n  ],\n  \"eval_ids\": [\n    \"eval_1\"\n  ],\n  \"max_rounds\": 3,\n  \"no_progress_rounds\": 2,\n  \"stop_on\": [\n    \"scope_violation\",\n    \"authority_changed\",\n    \"environment_unverified\",\n    \"budget_exhausted\",\n    \"cancelled\"\n  ],\n  \"on_failure\": \"park_with_context\",\n  \"runner\": \"taskmesh\",\n  \"required_capabilities\": [\n    \"managed_recipe_v1\",\n    \"persistent_round_budget\",\n    \"signed_timeout\"\n  ]\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"bc1bdb76-9aec-439c-aab4-d239c156bb31","uuid":"673c8b1e-085d-4252-8f22-69de3d2b4584","timestamp":"2026-09-14T21:42:43.972Z","tool_use_result":{"stdout":"EXAMPLE=WRITTEN example=recipe path=/private/tmp/ts-recipe-example.yaml action=created digest=sha256:62f535119aa7ff2cc5715360a93eaba8e09ead73c71594a6a10d4e03b4296dbf\n=== INTENT EXAMPLE ===\n# Candidate intent\n\nOutcome: restore successful checkout requests.\n\nEvidence: attach incident source, revision, observation time, and reproduction.\n\nConstraints: preserve the current public API; do not deploy until release authorization.\n\nOwner: record the responsible product owner.\n\nUnknowns: determine the evidenced cause before proposing a repair.\n=== RECIPE EXAMPLE ===\n{\n  \"contract\": \"TaskExecutionRecipe/v1\",\n  \"strategy\": \"diagnose-repair-verify\",\n  \"strategy_version\": \"1.0.0\",\n  \"steps\": [\n    \"Reproduce the failure and gather evidence before choosing a cause.\",\n    \"Repair the evidenced cause within scope.\",\n    \"Verify the reproduction and affected regression checks.\"\n  ],\n  \"context\": [\n    \"TaskHandoff\",\n    \"authorized Task-Spec\",\n    \"declared source evidence\"\n  ],\n  \"artifacts\": [\n    \"scoped changes\",\n    \"evaluation evidence\",\n    \"concise result\"\n  ],\n  \"eval_ids\": [\n    \"eval_1\"\n  ],\n  \"max_rounds\": 3,\n  \"no_progress_rounds\": 2,\n  \"stop_on\": [\n    \"scope_violation\",\n    \"authority_changed\",\n    \"environment_unverified\",\n    \"budget_exhausted\",\n    \"cancelled\"\n  ],\n  \"on_failure\": \"park_with_context\",\n  \"runner\": \"taskmesh\",\n  \"required_capabilities\": [\n    \"managed_recipe_v1\",\n    \"persistent_round_budget\",\n    \"signed_timeout\"\n  ]\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
