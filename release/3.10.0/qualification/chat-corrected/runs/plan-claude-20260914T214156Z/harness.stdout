{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012CBXdCsdKC8wvCYsF9cKuL","type":"tool_result","content":"        except UnsafeWriteTargetError as error:\n            return Result(\n                \"plan\",\n                PLAN_NEEDS_DECISION,\n                EXIT_CONFLICT,\n                root,\n                diagnostics=[_diag(\"unsafe_write_target\", str(error))],\n            )\n    next_steps = (\n        [\"Resolve every OPEN objection, then rerun: taskspec decompose prepare <initiative> --recipe <file> --replace\"]\n        if token == PLAN_OPEN_OBJECTIONS\n        else [\"taskspec decompose review <initiative> --accept --reviewer <name> --reason <reason>\"]\n    )\n    return Result(\n        \"plan\",\n        token,\n        exit_code,\n        root,\n        artifacts=writer.touched,\n        next_steps=next_steps,\n        data={\"swimlanes\": len(lane_index), \"legs\": len(leg_index), \"dry_run\": dry_run},\n    )\n\n\ndef accept_plan(\n    root: Path,\n    if not reviewer or not reason:\n        return Result(\n            \"review\",\n            PLAN_NEEDS_REVIEW,\n            EXIT_INVALID,\n            root,\n            diagnostics=[_diag(\"review_fields_blank\", \"Reviewer and reason must be nonblank.\")],\n        )\n    if plan.get(\"status\") == PLAN_OPEN_OBJECTIONS or any(\n        item.get(\"status\") == \"OPEN\" for item in plan.get(\"objections\", [])\n    ):\n        return Result(\n            \"review\",\n            PLAN_OPEN_OBJECTIONS,\n            EXIT_NEEDS_INPUT,\n            root,\n            diagnostics=[\n                _diag(\"open_objections\", \"Review cannot accept a plan with OPEN objections.\")\n            ],\n        )\n    if plan.get(\"seam_map_sha256\") != sha256_file(root / PLAN_DIR / \"seam-map.yaml\"):\n        return Result(\n            \"review\",\n            PLAN_NEEDS_REVIEW,\n            EXIT_CONFLICT,\n            root,\n            diagnostics=[\n                _diag(\"se