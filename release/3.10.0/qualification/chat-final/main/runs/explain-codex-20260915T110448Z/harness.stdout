{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc 'bash \"/private/tmp/taskspec-qualified-engines/3.10.0/bin/taskspec\" graph --initiative rate-limit --view tasks'","aggregated_output":"DECOMPOSE=COMPILED initiative=rate-limit\nNEXT: taskspec batch --plan tasks/.plans/rate-limit/task-plan.json\n{\n  \"contract\": \"TaskInitiativeGraph/v1\",\n  \"initiative\": \"rate-limit\",\n  \"state\": \"compiled\",\n  \"view\": \"tasks\",\n  \"tasks\": [\n    {\n      \"id\": \"T-20260802-decision-visibility\",\n      \"depends_on\": [\n        \"T-20260802-request-101\"\n      ],\n      \"lineage\": {\n        \"intent\": \"DI-RATE-LIMIT\",\n        \"leg\": \"LEG-DENIAL-REASON-VISIBLE\",\n        \"seam\": \"SEAM-DECISION-VISIBILITY\",\n        \"source_sha256\": \"7708d24a7ec1d260bf161f9eaa0c51aee7928d0a990b947211dc9d4234e66a22\",\n        \"swimlane\": \"LANE-DECISION-VISIBILITY\",\n        \"unit_id\": \"T-20260802-decision-visibility\"\n      },\n      \"lifecycle\": \"not_materialized\",\n      \"acceptance\": {\n        \"accepted\": false,\n        \"record_matches\": false\n      }\n    },\n    {\n      \"id\": \"T-20260802-effective-policy\",\n      \"depends_on\": [\n        \"T-20260802-policy-schema\"\n      ],\n      \"lineage\": {\n        \"intent\": \"DI-RATE-LIMIT\",\n        \"leg\": \"LEG-EFFECTIVE-POLICY-RESOLVED\",\n        \"seam\": \"SEAM-POLICY-RESOLUTION\",\n        \"source_sha256\": \"26f335719fee7ca79bbf14948a1444851e4e41f1c6e03cdec7ad57ed29c05362\",\n        \"swimlane\": \"LANE-POLICY-RESOLUTION\",\n        \"unit_id\": \"T-20260802-effective-policy\"\n      },\n      \"lifecycle\": \"not_materialized\",\n      \"acceptance\": {\n        \"accepted\": false,\n        \"record_matches\": false\n      }\n    },\n    {\n      \"id\": \"T-20260802-policy-schema\",\n      \"depends_on\": [],\n      \"lineage\": {\n        \"intent\": \"DI-RATE-LIMIT\",\n        \"leg\": \"LEG-POLICY-SCHEMA-VALID\",\n        \"seam\": \"SEAM-POLICY-CONTRACT\",\n        \"source_sha256\": \"95b39479a3c2c5d5264e9b2aed370e7c5f77444f7a70d4cf4f571cb9b9f2f172\",\n        \"swimlane\": \"LANE-POLICY-CONTRACT\",\n        \"unit_id\": \"T-20260802-policy-schema\"\n      },\n      \"lifecycle\": \"not_materialized\",\n      \"acceptance\": {\n        \"accepted\": false,\n        \"record_matches\": false\n      }\n    },\n    {\n      \"id\": \"T-20260802-request-101\",\n      \"depends_on\": [\n        \"T-20260802-effective-policy\"\n      ],\n      \"lineage\": {\n        \"intent\": \"DI-RATE-LIMIT\",\n        \"leg\": \"LEG-REQUEST-101-DENIED\",\n        \"seam\": \"SEAM-REQUEST-ENFORCEMENT\",\n        \"source_sha256\": \"5fd8c58ad4df7a0b7002f9fc805b546fdf268cb010b20049d8c5613bc1e74d91\",\n        \"swimlane\": \"LANE-REQUEST-ENFORCEMENT\",\n        \"unit_id\": \"T-20260802-request-101\"\n      },\n      \"lifecycle\": \"not_materialized\",\n      \"acceptance\": {\n        \"accepted\": false,\n        \"record_matches\": false\n      }\n    }\n  ],\n  \"capabilities\": [\n    {\n      \"leg\": \"LEG-DENIAL-REASON-VISIBLE\",\n      \"seam\": \"SEAM-DECISION-VISIBILITY\",\n      \"swimlane\": \"LANE-DECISION-VISIBILITY\",\n      \"tasks\": [\n        \"T-20260802-decision-visibility\"\n      ],\n      \"proof_tasks\": [],\n      \"state\": \"unproven\",\n      \"gap\": \"integration proof task missing\"\n    },\n    {\n      \"leg\": \"LEG-EFFECTIVE-POLICY-RESOLVED\",\n      \"seam\": \"SEAM-POLICY-RESOLUTION\",\n      \"swimlane\": \"LANE-POLICY-RESOLUTION\",\n      \"tasks\": [\n        \"T-20260802-effective-policy\"\n      ],\n      \"proof_tasks\": [],\n      \"state\": \"unproven\",\n      \"gap\": \"integration proof task missing\"\n    },\n    {\n      \"leg\": \"LEG-POLICY-SCHEMA-VALID\",\n      \"seam\": \"SEAM-POLICY-CONTRACT\",\n      \"swimlane\": \"LANE-POLICY-CONTRACT\",\n      \"tasks\": [\n        \"T-20260802-policy-schema\"\n      ],\n      \"proof_tasks\": [],\n      \"state\": \"unproven\",\n      \"gap\": \"integration proof task missing\"\n    },\n    {\n      \"leg\": \"LEG-REQUEST-101-DENIED\",\n      \"seam\": \"SEAM-REQUEST-ENFORCEMENT\",\n      \"swimlane\": \"LANE-REQUEST-ENFORCEMENT\",\n      \"tasks\": [\n        \"T-20260802-request-101\"\n      ],\n      \"proof_tasks\": [],\n      \"state\": \"unproven\",\n      \"gap\": \"integration proof task missing\"\n    }\n  ],\n  \"accepted_tasks\": [],\n  \"attempts\": [],\n  \"proof_gaps\": [\n    \"LEG-DENIAL-REASON-VISIBLE\",\n    \"LEG-EFFECTIVE-POLICY-RESOLVED\",\n    \"LEG-POLICY-SCHEMA-VALID\",\n    \"LEG-REQUEST-101-DENIED\"\n  ],\n  \"next\": [\n    \"taskspec batch --plan tasks/.plans/rate-limit/task-plan.json\"\n  ]\n}\n","exit_code":0,"status":"completed"}}
