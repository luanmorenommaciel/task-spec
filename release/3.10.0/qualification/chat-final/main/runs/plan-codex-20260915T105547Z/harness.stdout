mpose/engine/planning.py:92:                    \"The authored system map contains unresolved architecture unknowns.\",\n/private/tmp/taskspec-qualified-engines/3.10.0/src/decompose/engine/planning.py:94:                    unknowns=unknowns,\n/private/tmp/taskspec-qualified-engines/3.10.0/src/decompose/engine/planning.py:101:    objections = system.get(\"objections\", [])\n/private/tmp/taskspec-qualified-engines/3.10.0/src/decompose/engine/planning.py:102:    for objection in objections:\n/private/tmp/taskspec-qualified-engines/3.10.0/src/decompose/engine/planning.py:119:        PLAN_OPEN_OBJECTIONS\n/private/tmp/taskspec-qualified-engines/3.10.0/src/decompose/engine/planning.py:120:        if any(item.get(\"status\") == \"OPEN\" for item in objections)\n/private/tmp/taskspec-qualified-engines/3.10.0/src/decompose/engine/planning.py:177:            \"objections\": objections,\n/private/tmp/taskspec-qualified-engines/3.10.0/src/decompose/engine/planning.py:264:        [\"Resolve every OPEN objection, then rerun: taskspec decompose prepare <initiative> --recipe <file> --replace\"]\n/private/tmp/taskspec-qualified-engines/3.10.0/src/decompose/engine/planning.py:265:        if token == PLAN_OPEN_OBJECTIONS\n/private/tmp/taskspec-qualified-engines/3.10.0/src/decompose/engine/planning.py:313:    if plan.get(\"status\") == PLAN_OPEN_OBJECTIONS or any(\n/private/tmp/taskspec-qualified-engines/3.10.0/src/decompose/engine/planning.py:314:        item.get(\"status\") == \"OPEN\" for item in plan.get(\"objections\", [])\n/private/tmp/taskspec-qualified-engines/3.10.0/src/decompose/engine/planning.py:318:            PLAN_OPEN_OBJECTIONS,\n/private/tmp/taskspec-qualified-engines/3.10.0/src/decompose/engine/planning.py:322:                _diag(\"open_objections\", \"Review cannot accept a plan with OPEN objections.\")\n","exit_code":0,"status":"completed"}}
