{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc 'bash \"/private/tmp/taskspec-qualified-engines/3.10.0/bin/taskspec\" agent-context'","aggregated_output":"{\n  \"contract\": \"TaskSpecAgentContext/v1\",\n  \"engine_version\": \"3.10.0\",\n  \"format_version\": 4,\n  \"default_format_version\": 3,\n  \"supported_format_versions\": [\n    1,\n    2,\n    3,\n    4\n  ],\n  \"binary\": \"taskspec\",\n  \"global_options\": {\n    \"--json\": \"wrap command stdout/stderr and exit status in one JSON envelope\",\n    \"--dry-run\": \"prevent supported mutations and report intended action\",\n    \"NO_COLOR\": \"disable ANSI color when present\",\n    \"TASKSPEC_COLOR\": \"0 disables and 1 forces ANSI color\"\n  },\n  \"exit_codes\": {\n    \"0\": \"success\",\n    \"1\": \"validation, gate, eval, or acceptance failure\",\n    \"2\": \"usage error\",\n    \"3\": \"unsupported runtime requirement\"\n  },\n  \"commands\": {\n    \"init\": {\n      \"mutation\": \"creates missing tasks/ and .taskspec/config\",\n      \"tokens\": [\n        \"INIT=OK\",\n        \"INIT=DRY_RUN\"\n      ],\n      \"usage\": \"Usage: taskspec init [--force]\",\n      \"flags\": [\n        \"--force\"\n      ],\n      \"summary\": \"creates missing tasks/ and .taskspec/config\"\n    },\n    \"setup\": {\n      \"mutation\": \"none\",\n      \"tokens\": [\n        \"SETUP=READY\"\n      ],\n      \"usage\": \"Usage: taskspec setup | taskspec setup signing [--force] | taskspec setup decompose\",\n      \"flags\": [\n        \"--force\"\n      ],\n      \"summary\": \"none\"\n    },\n    \"setup signing\": {\n      \"mutation\": \"creates or explicitly rotates the repository-private HMAC key\",\n      \"tokens\": [],\n      \"usage\": \"Usage: taskspec setup signing\",\n      \"flags\": [],\n      \"summary\": \"creates or explicitly rotates the repository-private HMAC key\"\n    },\n    \"demo\": {\n      \"mutation\": \"creates and removes an isolated temporary repository\",\n      \"tokens\": [\n        \"DEMO=READY\",\n        \"DEMO=DRY_RUN\",\n        \"DEMO=BLOCKED\"\n      ],\n      \"usage\": \"Usage: taskspec demo\",\n      \"flags\": [],\n      \"summary\": \"creates and removes an isolated temporary repository\"\n    },\n    \"example\": {\n      \"mutation\": \"writes one installed canonical example non-clobberingly; --force replaces and --dry-run writes nothing\",\n      \"tokens\": [\n        \"EXAMPLE=WRITTEN\",\n        \"EXAMPLE=DRY_RUN\",\n        \"EXAMPLE=REFUSED\"\n      ],\n      \"usage\": \"Usage: taskspec example task-plan --out <file> [--force]\",\n      \"flags\": [\n        \"--force\",\n        \"--out\"\n      ],\n      \"summary\": \"writes one installed canonical example non-clobberingly; --force replaces and --dry-run writes nothing\\nExamples: task-plan, intent, recipe, incident, release-evidence. Use taskspec help example <kind>.\"\n    },\n    \"new\": {\n      \"mutation\": \"creates one Task-Spec scaffold and derived state\",\n      \"tokens\": [],\n      \"usage\": \"Usage: taskspec new [--format 3|4] [--status ready|blocked] [--queue] <slug> <XS|S|M|L|XL|XXL> [agent] [source-note]\",\n      \"flags\": [\n        \"--format\",\n        \"--queue\",\n        \"--status\"\n      ],\n      \"summary\": \"creates one Task-Spec scaffold and derived state\"\n    },\n    \"plan\": {\n      \"mutation\": \"none\",\n      \"tokens\": [\n        \"TASK_PLAN=OK\",\n        \"TASK_PLAN=INVALID\"\n      ],\n      \"usage\": \"Usage: taskspec plan --manifest <TaskPlan.yaml>\",\n      \"flags\": [\n        \"--manifest\"\n      ],\n      \"summary\": \"none\"\n    },\n    \"batch\": {\n      \"mutation\": \"creates declared Task-Spec scaffolds; --dry-run writes nothing\",\n      \"tokens\": [\n        \"TASK_BATCH=OK\",\n        \"TASK_BATCH=DRY_RUN\",\n        \"TASK_BATCH=REFUSED\"\n      ],\n      \"usage\": \"Usage: taskspec batch --plan <TaskPlan.yaml> | taskspec batch --intent-file <file> --effort <size>\",\n      \"flags\": [\n        \"--effort\",\n        \"--intent-file\",\n        \"--plan\"\n      ],\n      \"summary\": \"creates declared Task-Spec scaffolds; --dry-run writes nothing\"\n    },\n    \"migrate\": {\n      \"mutation\": \"atomically upgrades one explicitly named legacy task under the task-state lock\",\n      \"tokens\": [],\n      \"usage\": \"Usage: taskspec migrate <task-spec>\",\n      \"flags\": [],\n      \"summary\": \"atomically upgrades one explicitly named legacy task under the task-state lock\"\n    },\n    \"validate\": {\n      \"mutation\": \"refreshes deterministic derived state unless --no-state\",\n      \"tokens\": [],\n      \"usage\": \"Usage: taskspec validate [--no-state] <task-spec>\",\n      \"flags\": [\n        \"--no-state\"\n      ],\n      \"summary\": \"refreshes deterministic derived state unless --no-state\"\n    },\n    \"dod\": {\n      \"mutation\": \"none\",\n      \"tokens\": [\n        \"DOD=COMPLETE\",\n        \"DOD=GAPS\"\n      ],\n      \"usage\": \"Usage: taskspec dod <task-spec>\",\n      \"flags\": [],\n      \"summary\": \"none\"\n    },\n    \"gate\": {\n      \"mutation\": \"executes task evals; --stamp additionally writes the sign-off envelope\",\n      \"tokens\": [\n        \"TIER=1\",\n        \"TIER=2\"\n      ],\n      \"usage\": \"Usage: taskspec gate [--stamp] [--require-tier1] <task-spec>\",\n      \"flags\": [\n        \"--require-tier\",\n        \"--stamp\"\n      ],\n      \"summary\": \"executes task evals; --stamp additionally writes the sign-off envelope\"\n    },\n    \"handoff\": {\n      \"mutation\": \"stdout is read-only; --out writes non-clobberingly unless --force\",\n      \"tokens\": [\n        \"HANDOFF=WRITTEN\",\n        \"HANDOFF=INVALID\",\n        \"HANDOFF=REFUSED\"\n      ],\n      \"usage\": \"Usage: taskspec handoff <task-spec> --backend <token> [--out <file>] [--attempt-id <uuid>]\",\n      \"flags\": [\n        \"--attempt-id\",\n        \"--backend\",\n        \"--out\"\n      ],\n      \"summary\": \"stdout is read-only; --out writes non-clobberingly unless --force\"\n    },\n    \"run\": {\n      \"mutation\": \"runs declared eval commands in the task workspace\",\n      \"tokens\": [],\n      \"usage\": \"Usage: taskspec run [--ci] <task-spec>\",\n      \"flags\": [\n        \"--ci\"\n      ],\n      \"summary\": \"runs declared eval commands in the task workspace\"\n    },\n    \"accept\": {\n      \"mutation\": \"executes acceptance evals; --stamp additionally writes AcceptanceRecord/v1 and the acceptance envelope\",\n      \"tokens\": [\n        \"ACCEPTED=1\",\n        \"ACCEPTED=0\",\n        \"ACCEPTANCE_FAILURE=<code>\"\n      ],\n      \"usage\": \"Usage: taskspec accept [--stamp] [--handoff <file>] [receipt flags] <task-spec>\",\n      \"flags\": [\n        \"--handoff\",\n        \"--stamp\"\n      ],\n      \"summary\": \"executes acceptance evals; --stamp additionally writes AcceptanceRecord/v1 and the acceptance envelope\"\n    },\n    \"author-doctor\": {\n      \"mutation\": \"none\",\n      \"tokens\": [\n        \"AUTHOR_DOCTOR=READY\",\n        \"AUTHOR_DOCTOR=INVALID\"\n      ],\n      \"usage\": \"Usage: taskspec author-doctor <task-spec>\",\n      \"flags\": [],\n      \"summary\": \"none\"\n    },\n    \"holdout\": {\n      \"mutation\": \"seal/run may write descriptor or receipt; verify is read-only\",\n      \"tokens\": [\n        \"HOLDOUT=SEALED\",\n        \"HOLDOUT=VERIFIED\",\n        \"HOLDOUT=INVALID\"\n      ],\n      \"usage\": \"Usage: taskspec holdout seal|verify|run ...\",\n      \"flags\": [],\n      \"summary\": \"seal/run may write descriptor or receipt; verify is read-only\"\n    },\n    \"receipt\": {\n      \"mutation\": \"creator/sign commands write explicit receipt paths; validate is read-only\",\n      \"tokens\": [\n        \"RECEIPT=WRITTEN\",\n        \"RECEIPT=SIGNED\",\n        \"RECEIPT=INVALID\"\n      ],\n      \"usage\": \"Usage: taskspec receipt validate|sign|engine|environment|evaluation|graded|human ...\",\n      \"flags\": [],\n      \"summary\": \"creator/sign commands write explicit receipt paths; validate is read-only\"\n    },\n    \"eval-audit\": {\n      \"mutation\": \"uses temporary git worktrees; optional report path\",\n      \"tokens\": [\n        \"EVAL_AUDIT=INVALID\"\n      ],\n      \"usage\": \"Usage: taskspec eval-audit <task-spec> --baseline <git-ref> [--mutations <matrix>] [--repeat N]\",\n      \"flags\": [\n        \"--baseline\",\n        \"--mutations\",\n        \"--repeat\"\n      ],\n      \"summary\": \"uses temporary git worktrees; optional report path\"\n    },\n    \"identity\": {\n      \"mutation\": \"init/sign/revoke write explicit files; verify is read-only\",\n      \"tokens\": [\n        \"IDENTITY=READY\",\n        \"IDENTITY=SIGNED\",\n        \"IDENTITY=VERIFIED\",\n        \"IDENTITY=REVOKED\"\n      ],\n      \"usage\": \"Usage: taskspec identity init|sign|verify|revoke ...\",\n      \"flags\": [],\n      \"summary\": \"init/sign/revoke write explicit files; verify is read-only\"\n    },\n    \"evidence\": {\n      \"mutation\": \"run writes an explicit evidence directory; validate/plan are read-only\",\n      \"tokens\": [\n        \"ENGINE_MATRIX=VALID\",\n        \"ENGINE_MATRIX=INVALID\"\n      ],\n      \"usage\": \"Usage: taskspec evidence validate|plan|run <EngineMatrix.json> ...\",\n      \"flags\": [],\n      \"summary\": \"run writes an explicit evidence directory; validate/plan are read-only\"\n    },\n    \"bridge\": {\n      \"mutation\": \"export writes only with --out; validate is read-only\",\n      \"tokens\": [\n        \"BRIDGE=VALID\",\n        \"BRIDGE=INVALID\"\n      ],\n      \"usage\": \"Usage: taskspec bridge export|validate ...\",\n      \"flags\": [],\n      \"summary\": \"export writes only with --out; validate is read-only\"\n    },\n    \"dsse\": {\n      \"mutation\": \"export writes only to --out; verify is read-only\",\n      \"tokens\": [\n        \"DSSE=EXPORTED\",\n        \"DSSE=VERIFIED\",\n        \"DSSE=INVALID\"\n      ],\n      \"usage\": \"Usage: taskspec dsse export|verify ...\",\n      \"flags\": [],\n      \"summary\": \"export writes only to --out; verify is read-only\"\n    },\n    \"mcp\": {\n      \"mutation\": \"read-only stdio server\",\n      \"tokens\": [],\n      \"usage\": \"Usage: taskspec mcp\",\n      \"flags\": [],\n      \"summary\": \"read-only stdio server\"\n    },\n    \"mesh\": {\n      \"mutation\": \"optional repository-local control plane; run/cancel/resume/accept/finish/setup mutate disposable mesh state while canonical acceptance still calls Task-Spec\",\n      \"tokens\": [\n        \"MESH_WATCH_READY\",\n        \"MESH_SUPERVISED_ACCEPTED\",\n        \"MESH_FINISHED\",\n        \"TASKMESH_ERROR=<code>\",\n        \"TASKMESH_DRY_RUN\"\n      ],\n      \"usage\": \"Usage: taskspec mesh <init|doctor|serve|frontier|run|status|watch|explain|cancel|resume|accept|finish|adapters|setup|mcp> ... | taskspec mesh run --initiative <id> [--execute]\",\n      \"flags\": [\n        \"--execute\",\n        \"--initiative\"\n      ],\n      \"summary\": \"optional repository-local control plane; run/cancel/resume/accept/finish/setup mutate disposable mesh state while canonical acceptance still calls Task-Spec\"\n    },\n    \"ready\": {\n      \"mutation\": \"none\",\n      \"tokens\": [],\n      \"usage\": \"Usage: taskspec ready [--all] [filters]\",\n      \"flags\": [\n        \"--all\"\n      ],\n      \"summary\": \"none\"\n    },\n    \"graph\": {\n      \"mutation\": \"none; TaskGraphView/v1 is derived from Markdown and Git\",\n      \"tokens\": [\n        \"GRAPH=<digest>\",\n        \"GRAPH=INVALID\"\n      ],\n      \"usage\": \"Usage: taskspec graph [--task <id>] [--check] [--mermaid] [--json] | taskspec graph --initiative <id> --view tasks|capabilities\",\n      \"flags\": [\n        \"--check\",\n        \"--initiative\",\n        \"--json\",\n        \"--mermaid\",\n        \"--task\",\n        \"--view\"\n      ],\n      \"summary\": \"none; TaskGraphView/v1 is derived from Markdown and Git\"\n    },\n    \"status\": {\n      \"mutation\": \"none; emits TaskStatus/v1 and exactly one safe next command\",\n      \"tokens\": [\n        \"NEXT=<command>\",\n        \"STATUS=INVALID\"\n      ],\n      \"usage\": \"Usage: taskspec status <task-id-or-path> [--json] | taskspec status --initiative <id>\",\n      \"flags\": [\n        \"--initiative\",\n        \"--json\"\n      ],\n      \"summary\": \"none; emits TaskStatus/v1 and exactly one safe next command\"\n    },\n    \"lint\": {\n      \"mutation\": \"none\",\n      \"tokens\": [],\n      \"usage\": \"Usage: taskspec lint\",\n      \"flags\": [],\n      \"summary\": \"none\"\n    },\n    \"transition\": {\n      \"mutation\": \"changes lifecycle status and derived state\",\n      \"tokens\": [],\n      \"usage\": \"Usage: taskspec transition <task-id> <ready|in-progress|blocked|done|parked> [reason]\",\n      \"flags\": [],\n      \"summary\": \"changes lifecycle status and derived state\"\n    },\n    \"rebuild-state\": {\n      \"mutation\": \"rewrites deterministic tasks/_state.yaml\",\n      \"tokens\": [],\n      \"usage\": \"Usage: taskspec rebuild-state\",\n      \"flags\": [],\n      \"summary\": \"rewrites deterministic tasks/_state.yaml\"\n    },\n    \"archive\": {\n      \"mutation\": \"moves root done/parked tasks under the task-state lock and refreshes derived state\",\n      \"tokens\": [],\n      \"usage\": \"Usage: taskspec archive\",\n      \"flags\": [],\n      \"summary\": \"moves root done/parked tasks under the task-state lock and refreshes derived state\"\n    },\n    \"backup\": {\n      \"mutation\": \"writes a timestamped backlog archive to the selected destination\",\n      \"tokens\": [],\n      \"usage\": \"Usage: taskspec backup [destination-directory]\",\n      \"flags\": [],\n      \"summary\": \"writes a timestamped backlog archive to the selected destination\"\n    },\n    \"metrics\": {\n      \"mutation\": \"none\",\n      \"tokens\": [],\n      \"usage\": \"Usage: taskspec metrics [--since YYYY-MM-DD] [--author <name>] [--status <status>]\",\n      \"flags\": [\n        \"--author\",\n        \"--since\",\n        \"--status\"\n      ],\n      \"summary\": \"none\"\n    },\n    \"conformance\": {\n      \"mutation\": \"self-test uses disposable fixtures only\",\n      \"tokens\": [],\n      \"usage\": \"Usage: taskspec conformance --self-test | --level L0|L1|L2 --executor <command>\",\n      \"flags\": [\n        \"--executor\",\n        \"--level\",\n        \"--self-test\"\n      ],\n      \"summary\": \"self-test uses disposable fixtures only\"\n    },\n    \"executor\": {\n      \"mutation\": \"reference L2 executor; transitions, executes, accepts, or parks one supplied task\",\n      \"tokens\": [],\n      \"usage\": \"Usage: taskspec executor <task-spec>\",\n      \"flags\": [],\n      \"summary\": \"reference L2 executor; transitions, executes, accepts, or parks one supplied task\"\n    },\n    \"agent-context\": {\n      \"mutation\": \"none\",\n      \"tokens\": [],\n      \"usage\": \"Usage: taskspec agent-context\",\n      \"flags\": [],\n      \"summary\": \"none\"\n    },\n    \"completion\": {\n      \"mutation\": \"none\",\n      \"tokens\": [],\n      \"usage\": \"Usage: taskspec completion bash|zsh|fish\",\n      \"flags\": [],\n      \"summary\": \"none\"\n    },\n    \"doctor\": {\n      \"mutation\": \"none\",\n      \"tokens\": [\n        \"BACKLOG_DOCTOR=READY\",\n        \"BACKLOG_DOCTOR=BLOCKED\",\n        \"DOCTOR=READY\",\n        \"DOCTOR=BLOCKED\"\n      ],\n      \"usage\": \"Usage: taskspec doctor [--backlog]\",\n      \"flags\": [\n        \"--backlog\"\n      ],\n      \"summary\": \"none\"\n    },\n    \"version\": {\n      \"mutation\": \"none\",\n      \"tokens\": [],\n      \"usage\": \"Usage: taskspec version\",\n      \"flags\": [],\n      \"summary\": \"none\"\n    },\n    \"help\": {\n      \"mutation\": \"none\",\n      \"tokens\": [],\n      \"usage\": \"Usage: taskspec help [command]\",\n      \"flags\": [],\n      \"summary\": \"none\"\n    },\n    \"decompose\": {\n      \"usage\": \"Usage: taskspec decompose init|prepare|review|compile|status|impact|import <initiative> [options]\",\n      \"summary\": \"Native intent decomposition, signed topology review, and TaskPlan compilation.\",\n      \"mutation\": \"Native intent decomposition, signed topology review, and TaskPlan compilation.\",\n      \"tokens\": [],\n      \"flags\": []\n    },\n    \"recipe\": {\n      \"usage\": \"Usage: taskspec recipe list|show <strategy>|validate <file> [--budget <n>]\",\n      \"summary\": \"Inspect and validate resolved bounded execution guidance.\",\n      \"mutation\": \"none\",\n      \"tokens\": [],\n      \"flags\": [\n        \"--budget\"\n      ]\n    },\n    \"guide\": {\n      \"usage\": \"Usage: taskspec guide <topic>\",\n      \"summary\": \"Read version-matched installed workflow guidance.\",\n      \"mutation\": \"none\",\n      \"tokens\": [],\n      \"flags\": []\n    },\n    \"decompose init\": {\n      \"usage\": \"Usage: taskspec decompose init <initiative> --intent-file <file|->\",\n      \"summary\": \"Create explicit intent workspace.\",\n      \"mutation\": \"Create explicit intent workspace.\",\n      \"tokens\": [],\n      \"flags\": [\n        \"--intent-file\"\n      ]\n    },\n    \"decompose prepare\": {\n      \"usage\": \"Usage: taskspec decompose prepare <initiative> --recipe <file> [--replace]\",\n      \"summary\": \"Validate and project an authored recipe; never approve it.\",\n      \"mutation\": \"Validate and project an authored recipe; never approve it.\",\n      \"tokens\": [],\n      \"flags\": [\n        \"--recipe\",\n        \"--replace\"\n      ]\n    },\n    \"decompose review\": {\n      \"usage\": \"Usage: taskspec decompose review <initiative> --accept --reviewer <name> --reason <text>\",\n      \"summary\": \"Authenticate explicit approval of the current topology.\",\n      \"mutation\": \"Authenticate explicit approval of the current topology.\",\n      \"tokens\": [],\n      \"flags\": [\n        \"--accept\",\n        \"--reason\",\n        \"--reviewer\"\n      ]\n    },\n    \"decompose compile\": {\n      \"usage\": \"Usage: taskspec decompose compile <initiative>\",\n      \"summary\": \"Compile reviewed topology and lineage without sealing leaves.\",\n      \"mutation\": \"Compile reviewed topology and lineage without sealing leaves.\",\n      \"tokens\": [],\n      \"flags\": []\n    },\n    \"decompose status\": {\n      \"usage\": \"Usage: taskspec decompose status <initiative>\",\n      \"summary\": \"Explain planning blockers and next valid action.\",\n      \"mutation\": \"none\",\n      \"tokens\": [],\n      \"flags\": []\n    },\n    \"decompose impact\": {\n      \"usage\": \"Usage: taskspec decompose impact <initiative> --against <bundle-or-snapshot.json>\",\n      \"summary\": \"Compare leaf projections to identify affected authorizations.\",\n      \"mutation\": \"none\",\n      \"tokens\": [],\n      \"flags\": [\n        \"--against\"\n      ]\n    },\n    \"decompose import\": {\n      \"usage\": \"Usage: taskspec decompose import <initiative> --source <workspace>\",\n      \"summary\": \"Explicitly import originals; fresh native review required.\",\n      \"mutation\": \"Explicitly import originals; fresh native review required.\",\n      \"tokens\": [],\n      \"flags\": [\n        \"--source\"\n      ]\n    },\n    \"recipe list\": {\n      \"usage\": \"Usage: taskspec recipe list \",\n      \"summary\": \"List available pinned strategies.\",\n      \"mutation\": \"none\",\n      \"tokens\": [],\n      \"flags\": []\n    },\n    \"recipe show\": {\n      \"usage\": \"Usage: taskspec recipe show <strategy>\",\n      \"summary\": \"Show resolved guidance.\",\n      \"mutation\": \"none\",\n      \"tokens\": [],\n      \"flags\": []\n    },\n    \"recipe validate\": {\n      \"usage\": \"Usage: taskspec recipe validate <file> [--budget <n>]\",\n      \"summary\": \"Validate a resolved recipe.\",\n      \"mutation\": \"none\",\n      \"tokens\": [],\n      \"flags\": [\n        \"--budget\"\n      ]\n    },\n    \"setup decompose\": {\n      \"usage\": \"Usage: taskspec setup decompose \",\n      \"summary\": \"Provision locked dependencies in the private runtime.\",\n      \"mutation\": \"Provision locked dependencies in the private runtime.\",\n      \"tokens\": [],\n      \"flags\": []\n    },\n    \"receipt operational\": {\n      \"usage\": \"Usage: taskspec receipt operational validate <file> | import <file> --out <path>\",\n      \"summary\": \"Validate or import operational evidence without upgrading its trust.\",\n      \"mutation\": \"Validate or import operational evidence without upgrading its trust.\",\n      \"tokens\": [],\n      \"flags\": [\n        \"--out\"\n      ]\n    },\n    \"mesh init\": {\n      \"usage\": \"Usage: taskspec mesh init \",\n      \"summary\": \"Use the existing TaskMesh init operation.\",\n      \"mutation\": \"mutates TaskMesh state; never grants a TaskSpec seal\",\n      \"tokens\": [],\n      \"flags\": []\n    },\n    \"mesh doctor\": {\n      \"usage\": \"Usage: taskspec mesh doctor \",\n      \"summary\": \"Use the existing TaskMesh doctor operation.\",\n      \"mutation\": \"may initialize a missing daemon and write Git metadata; does not seal or accept tasks\",\n      \"tokens\": [],\n      \"flags\": []\n    },\n    \"mesh serve\": {\n      \"usage\": \"Usage: taskspec mesh serve --foreground\",\n      \"summary\": \"Use the existing TaskMesh serve operation.\",\n      \"mutation\": \"mutates TaskMesh state; never grants a TaskSpec seal\",\n      \"tokens\": [],\n      \"flags\": [\n        \"--foreground\"\n      ]\n    },\n    \"mesh frontier\": {\n      \"usage\": \"Usage: taskspec mesh frontier \",\n      \"summary\": \"Use the existing TaskMesh frontier operation.\",\n      \"mutation\": \"may initialize a missing daemon and write Git metadata; does not seal or accept tasks\",\n      \"tokens\": [],\n      \"flags\": []\n    },\n    \"mesh run\": {\n      \"usage\": \"Usage: taskspec mesh run --task <id>|--frontier|--initiative <id> [--adapter <name>] [--model <id>] [--provider <id>] [--mode supervised|autonomous] [--max-parallel <n>] [--execute]\",\n      \"summary\": \"Creates a run, worktree and lease; --execute starts the executor; --dry-run previews without creating them.\",\n      \"mutation\": \"mutates TaskMesh state; never grants a TaskSpec seal\",\n      \"tokens\": [],\n      \"flags\": [\n        \"--adapter\",\n        \"--execute\",\n        \"--frontier\",\n        \"--initiative\",\n        \"--max-parallel\",\n        \"--mode\",\n        \"--model\",\n        \"--provider\",\n        \"--task\"\n      ]\n    },\n    \"mesh status\": {\n      \"usage\": \"Usage: taskspec mesh status [<run-or-attempt>]\",\n      \"summary\": \"Use the existing TaskMesh status operation.\",\n      \"mutation\": \"uninitialized status is read-only; existing runtime inspection may restart its daemon\",\n      \"tokens\": [],\n      \"flags\": []\n    },\n    \"mesh watch\": {\n      \"usage\": \"Usage: taskspec mesh watch <run> [--after <sequence>]\",\n      \"summary\": \"Use the existing TaskMesh watch operation.\",\n      \"mutation\": \"may initialize a missing daemon and write Git metadata; does not seal or accept tasks\",\n      \"tokens\": [],\n      \"flags\": [\n        \"--after\"\n      ]\n    },\n    \"mesh explain\": {\n      \"usage\": \"Usage: taskspec mesh explain --task <id> [--adapter <name>] [--model <id>]\",\n      \"summary\": \"Use the existing TaskMesh explain operation.\",\n      \"mutation\": \"may initialize a missing daemon and write Git metadata; does not seal or accept tasks\",\n      \"tokens\": [],\n      \"flags\": [\n        \"--adapter\",\n        \"--model\",\n        \"--task\"\n      ]\n    },\n    \"mesh cancel\": {\n      \"usage\": \"Usage: taskspec mesh cancel <attempt>\",\n      \"summary\": \"Use the existing TaskMesh cancel operation.\",\n      \"mutation\": \"mutates TaskMesh state; never grants a TaskSpec seal\",\n      \"tokens\": [],\n      \"flags\": []\n    },\n    \"mesh resume\": {\n      \"usage\": \"Usage: taskspec mesh resume <run-or-attempt> [--execute]\",\n      \"summary\": \"Use the existing TaskMesh resume operation.\",\n      \"mutation\": \"mutates TaskMesh state; never grants a TaskSpec seal\",\n      \"tokens\": [],\n      \"flags\": [\n        \"--execute\"\n      ]\n    },\n    \"mesh accept\": {\n      \"usage\": \"Usage: taskspec mesh accept <attempt> --supervised-by <identity> --reason <text>\",\n      \"summary\": \"Use the existing TaskMesh accept operation.\",\n      \"mutation\": \"mutates TaskMesh state; never grants a TaskSpec seal\",\n      \"tokens\": [],\n      \"flags\": [\n        \"--reason\",\n        \"--supervised-by\"\n      ]\n    },\n    \"mesh finish\": {\n      \"usage\": \"Usage: taskspec mesh finish <run>\",\n      \"summary\": \"Use the existing TaskMesh finish operation.\",\n      \"mutation\": \"mutates TaskMesh state; never grants a TaskSpec seal\",\n      \"tokens\": [],\n      \"flags\": []\n    },\n    \"mesh adapters\": {\n      \"usage\": \"Usage: taskspec mesh adapters list|probe [<name>]\",\n      \"summary\": \"Use the existing TaskMesh adapters operation.\",\n      \"mutation\": \"may initialize a missing daemon and write Git metadata; does not seal or accept tasks; probe invokes adapter executables\",\n      \"tokens\": [],\n      \"flags\": []\n    },\n    \"mesh setup\": {\n      \"usage\": \"Usage: taskspec mesh setup sandbox\",\n      \"summary\": \"Use the existing TaskMesh setup operation.\",\n      \"mutation\": \"mutates TaskMesh state; never grants a TaskSpec seal\",\n      \"tokens\": [],\n      \"flags\": []\n    },\n    \"me