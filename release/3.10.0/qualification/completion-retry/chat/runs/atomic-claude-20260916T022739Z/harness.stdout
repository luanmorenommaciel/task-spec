{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01L8o2oMwMT1WwMSp26vSaqn","type":"tool_result","content":"a2a-artifact.schema.json\nacceptance-failure.schema.json\nacceptance-finalized.schema.json\nacceptance-record.schema.json\nagent-contract.schema.json\nauthoring-evidence.schema.json\nauthorization-receipt.schema.json\ncredential-lease.schema.json\ndecompose-delivery-plan-review.schema.json\ndecompose-delivery-plan.schema.json\ndecompose-recipe.schema.json\ndecompose-result-envelope.schema.json\ndecompose-seam-map.schema.json\ndecompose-task-graph.schema.json\ndecompose-task-lineage.schema.json\ndispatch-decision.schema.json\nengine-matrix-result.schema.json\nengine-matrix.schema.json\nengine-run-receipt.schema.json\nenvironment-attestation.schema.json\nenvironment-contract.schema.json\nenvironment-receipt.schema.json\nevaluation-receipt.schema.json\nevaluator-trust.schema.json\nexecutor-capability.schema.json\ngraded-evaluation-receipt.schema.json\nholdout-bundle.schema.json\nholdout-descriptor.schema.json\nhuman-acceptance-receipt.schema.json\nmcp-task.schema.json\nmutation-matrix.schema.json\nprotocol-conformance-evidence.schema.json\nprovider-smoke-evidence.schema.json\nquality-rubric.schema.json\nreceipt-subject.schema.json\nrun-lease.schema.json\nsandbox-evidence.schema.json\ntask-execution-recipe.schema.json\ntask-graph-view.schema.json\ntask-handoff.schema.json\ntask-materialization-receipt.schema.json\ntask-operational-evidence.schema.json\ntask-operational-import.schema.json\ntask-plan-bundle.schema.json\ntask-plan-import.schema.json\ntask-plan-provenance.schema.json\ntask-plan-snapshot.schema.json\ntask-plan.schema.json\ntask-revision.schema.json\ntask-spec-frontmatter.schema.json\ntask-spec-quality-scorecard.schema.json\ntask-spec-release-evidence.schema.json\ntask-status.schema.json\ntaskmesh-api.schema.json\ntaskmesh-event.schema.json\ntaskmesh-roster.schema.json\ntaskmesh-run.schema.json\ntaskmesh-view.schema.json\n=== taskplan schema ===\n{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://taskspec.dev/schemas/task-plan-bundle.schema.json\",\n  \"title\": \"TaskPlanBundle/v1\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\n    \"contract\",\n    \"initiative\",\n    \"plan_digest\",\n    \"lineage_digest\",\n    \"snapshot_digest\",\n    \"units\",\n    \"signature\"\n  ],\n  \"properties\": {\n    \"contract\": {\n      \"const\": \"TaskPlanBundle/v1\"\n    },\n    \"initiative\": {\n      \"type\": \"string\",\n      \"pattern\": \"^[a-z0-9][a-z0-9-]{0,79}$\"\n    },\n    \"plan_digest\": {\n      \"type\": \"string\",\n      \"pattern\": \"^[a-f0-9]{64}$\"\n    },\n    \"lineage_digest\": {\n      \"type\": \"string\",\n      \"pattern\": \"^[a-f0-9]{64}$\"\n    },\n    \"snapshot_digest\": {\n      \"type\": \"string\",\n      \"pattern\": \"^[a-f0-9]{64}$\"\n    },\n    \"units\": {\n      \"type\": \"object\",\n      \"minProperties\": 1,\n      \"additionalProperties\": {\n        \"type\": \"string\",\n        \"pattern\": \"^[a-f0-9]{64}$\"\n      }\n    },\n    \"signature\": {\n      \"type\": \"string\",\n      \"pattern\": \"^hmac-taskplan-v1:[a-f0-9]{8}:[a-f0-9]{64}$\"\n    }\n  }\n}\n{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://taskspec.dev/schemas/task-plan-import.schema.json\",\n  \"title\": \"TaskPlanImport/v1\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\n    \"contract\",\n    \"source\",\n    \"recipe_sha256\",\n    \"review_required\",\n    \"source_files\",\n    \"original_ids_preserved\"\n  ],\n  \"properties\": {\n    \"contract\": {\n      \"const\": \"TaskPlanImport/v1\"\n    },\n    \"source\": {\n      \"type\": \"string\",\n      \"minLength\": 1\n    },\n    \"recipe_sha256\": {\n      \"type\": \"string\",\n      \"pattern\": \"^[a-f0-9]{64}$\"\n    },\n    \"review_required\": {\n      \"const\": true\n    },\n    \"source_files\": {\n      \"type\": \"object\",\n      \"additionalProperties\": {\n        \"type\": \"string\",\n        \"pattern\": \"^[a-f0-9]{64}$\"\n      }\n    },\n    \"original_ids_preserved\": {\n      \"const\": true\n    }\n  }\n}\n{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://taskspec.dev/schemas/task-plan-provenance.schema.json\",\n  \"title\": \"TaskPlanProvenance/v1\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\n    \"contract\",\n    \"initiative\",\n    \"snapshot\",\n    \"snapshot_digest\",\n    \"projection_digest\"\n  ],\n  \"properties\": {\n    \"contract\": {\n      \"const\": \"TaskPlanProvenance/v1\"\n    },\n    \"initiative\": {\n      \"type\": \"string\",\n      \"pattern\": \"^[a-z0-9][a-z0-9-]{0,79}$\"\n    },\n    \"snapshot\": {\n      \"type\": \"string\",\n      \"pattern\": \"^tasks/\\\\.plans/[a-z0-9-]+/snapshots/[a-f0-9]{64}\\\\.json$\"\n    },\n    \"snapshot_digest\": {\n      \"type\": \"string\",\n      \"pattern\": \"^[a-f0-9]{64}$\"\n    },\n    \"projection_digest\": {\n      \"type\": \"string\",\n      \"pattern\": \"^[a-f0-9]{64}$\"\n    }\n  }\n}\n{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://taskspec.dev/schemas/task-plan-snapshot.schema.json\",\n  \"title\": \"TaskPlanSnapshot/v1\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\n    \"contract\",\n    \"initiative\",\n    \"review\",\n    \"reviewed_artifacts\",\n    \"units\",\n    \"signature\"\n  ],\n  \"properties\": {\n    \"contract\": {\n      \"const\": \"TaskPlanSnapshot/v1\"\n    },\n    \"initiative\": {\n      \"type\": \"string\",\n      \"pattern\": \"^[a-z0-9][a-z0-9-]{0,79}$\"\n    },\n    \"review\": {\n      \"$ref\": \"decompose-delivery-plan-review.schema.json\"\n    },","is_error":false}]},"parent_tool_use_id":null,"session_id":"63460af6-85b1-4ee1-9781-8ece24e10dc3","u