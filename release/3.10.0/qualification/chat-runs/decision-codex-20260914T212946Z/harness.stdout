ject an authored recipe; never approve it.\",\n      \"mutation\": \"Validate and project an authored recipe; never approve it.\",\n      \"tokens\": [],\n      \"flags\": [\n        \"--recipe\",\n        \"--replace\"\n      ]\n    },\n    \"decompose review\": {\n      \"usage\": \"Usage: taskspec decompose review <initiative> --accept --reviewer <name> --reason <text>\",\n      \"summary\": \"Authenticate explicit approval of the current topology.\",\n      \"mutation\": \"Authenticate explicit approval of the current topology.\",\n      \"tokens\": [],\n      \"flags\": [\n        \"--accept\",\n        \"--reason\",\n        \"--reviewer\"\n      ]\n    },\n    \"decompose compile\": {\n      \"usage\": \"Usage: taskspec decompose compile <initiative>\",\n      \"summary\": \"Compile reviewed topology and lineage without sealing leaves.\",\n      \"mutation\": \"Compile reviewed topology and lineage without sealing leaves.\",\n      \"tokens\": [],\n      \"flags\": []\n    },\n    \"decompose status\": {\n      \"usage\": \"Usage: taskspec decompose status <initiative>\",\n      \"summary\": \"Explain planning blockers and next valid action.\",\n      \"mutation\": \"none\",\n      \"tokens\": [],\n      \"flags\": []\n    },\n    \"decompose impact\": {\n      \"usage\": \"Usage: taskspec decompose impact <initiative> --against <bundle-or-snapshot.json>\",\n      \"summary\": \"Compare leaf projections to identify affected authorizations.\",\n      \"mutation\": \"none\",\n      \"tokens\": [],\n      \"flags\": [\n        \"--against\"\n      ]\n    },\n    \"decompose import\": {\n      \"usage\": \"Usage: taskspec decompose import <initiative> --source <workspace>\",\n      \"summary\": \"Explicitly import originals; fresh native review required.\",\n      \"mutation\": \"Explicitly import originals; fresh native review required.\",\n      \"tokens\": [],\n      \"flags\": [\n        \"--source\"\n      ]\n    },\n    \"recipe list\": {\n      \"usage\": 