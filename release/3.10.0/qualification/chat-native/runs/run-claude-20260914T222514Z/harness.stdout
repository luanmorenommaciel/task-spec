{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016gf6E3HWXW6RXVx2CPM5Hd","type":"tool_result","content":"{\n  \"contract\": \"TaskSpecAgentContext/v1\",\n  \"engine_version\": \"3.10.0\",\n  \"format_version\": 4,\n  \"default_format_version\": 3,\n  \"supported_format_versions\": [\n    1,\n    2,\n    3,\n    4\n  ],\n  \"binary\": \"taskspec\",\n  \"global_options\": {\n    \"--json\": \"wrap command stdout/stderr and exit status in one JSON envelope\",\n    \"--dry-run\": \"prevent supported mutations and report intended action\",\n    \"NO_COLOR\": \"disable ANSI color when present\",\n    \"TASKSPEC_COLOR\": \"0 disables and 1 forces ANSI color\"\n  },\n  \"exit_codes\": {\n    \"0\": \"success\",\n    \"1\": \"validation, gate, eval, or acceptance failure\",\n    \"2\": \"usage error\",\n    \"3\": \"unsupported runtime requirement\"\n  },\n  \"commands\": {\n    \"init\": {\n      \"mutation\": \"creates missing tasks/ and .taskspec/config\",\n      \"tokens\": [\n        \"INIT=OK\",\n        \"INIT=DRY_RUN\"\n      ],\n      \"usage\": \"Usage: taskspec init [--force]\",\n      \"flags\": [\n        \"--force\"\n      ],\n      \"summary\": \"creates missing tasks/ and .taskspec/config\"\n    },\n    \"setup\": {\n      \"mutation\": \"none\",\n      \"tokens\": [\n        \"SETUP=READY\"\n      ],\n      \"usage\": \"Usage: taskspec setup | taskspec setup signing [--force] | taskspec setup decompose\",\n      \"flags\": [\n        \"--force\"\n      ],\n      \"summary\": \"none\"\n    },\n    \"setup signing\": {\n      \"mutation\": \"creates or explicitly rotates the repository-private HMAC key\",\n      \"tokens\": [],\n      \"usage\": \"Usage: taskspec setup signing\",\n      \"flags\": [],\n      \"summary\": \"creates or explicitly rotates the repository-private HMAC key\"\n    },\n    \"demo\": {\n      \"mutation\": \"creates and removes an isolated temporary repository\",\n      \"tokens\": [\n        \"DEMO=READY\",\n