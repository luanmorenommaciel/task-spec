/references/schemas/sandbox-evidence.schema.json\n.claude/skills/task-spec/references/schemas/human-acceptance-receipt.schema.json\n.claude/skills/task-spec/references/schemas/decompose-seam-map.schema.json\n.claude/skills/task-spec/references/schemas/agent-contract.schema.json\n.claude/skills/task-spec/references/schemas/receipt-subject.schema.json\n.claude/skills/task-spec/references/schemas/decompose-delivery-plan.schema.json\n.claude/skills/task-spec/references/schemas/task-operational-evidence.schema.json\n.claude/skills/task-spec/references/schemas/authoring-evidence.schema.json\n.claude/skills/task-spec/references/schemas/task-operational-import.schema.json\n.claude/skills/task-spec/references/schemas/dispatch-decision.schema.json\n.claude/skills/task-spec/references/schemas/evaluation-receipt.schema.json\n.claude/skills/task-spec/references/schemas/authorization-receipt.schema.json\n.claude/skills/task-spec/references/schemas/mcp-task.schema.json\n.claude/skills/task-spec/references/schemas/holdout-bundle.schema.json\n.claude/skills/task-spec/references/schemas/task-spec-frontmatter.schema.json\n.claude/skills/task-spec/references/schemas/environment-contract.schema.json\n.claude/skills/task-spec/references/schemas/task-plan.schema.json\n.claude/skills/task-spec/references/schemas/taskmesh-event.schema.json\n.claude/skills/task-spec/references/schemas/decompose-delivery-plan-review.schema.json\n.claude/skills/task-spec/references/schemas/task-spec-release-evidence.schema.json\n.claude/skills/task-spec/references/schemas/evaluator-trust.schema.json\n.claude/skills/task-spec/references/schemas/task-materialization-receipt.schema.json\n.claude/skills/task-spec/references/schemas/engine-matrix.schema.json\n.claude/skills/task-spec/references/schemas/executor-capability.schema.json\n.claude/skills/task-spec/references/schemas/acceptance-failure.schema.json\n.claude/skills/task-spec/references/schemas/task-revision.schema.json\n.claude/skills/task-spec/references/schemas/mutation-matrix.schema.json\n.claude/skills/task-spec/references/schemas/task-handoff.schema.json\n.claude/skills/task-spec/references/schemas/provider-smoke-evidence.schema.json\n.claude/skills/task-spec/references/schemas/run-lease.schema.json\n.claude/skills/task-spec/references/schemas/acceptance-record.schema.json\n.claude/skills/task-spec/references/schemas/task-status.schema.json\n.claude/skills/task-spec/references/schemas/decompose-recipe.schema.json\n.claude/skills/task-spec/references/schemas/graded-evaluation-receipt.schema.json\n.claude/skills/task-spec/references/schemas/a2a-artifact.schema.json\n.claude/skills/task-spec/references/schemas/task-graph-view.schema.json\n.claude/skills/task-spec/references/schemas/task-plan-provenance.schema.json\n.claude/skills/task-spec/references/schemas/engine-run-receipt.schema.json\n.claude/skills/task-spec/references/schemas/protocol-conformance-evidence.schema.json\n.claude/skills/task-spec/references/schemas/task-execution-recipe.schema.json\n.claude/skills/task-spec/references/schemas/taskmesh-run.schema.json\n.claude/skills/task-spec/references/schemas/environment-attestation.schema.json\n.claude/skills/task-spec/references/schemas/engine-matrix-result.schema.json\n.claude/skills/task-spec/references/schemas/taskmesh-roster.schema.json\n.claude/skills/task-spec/references/schemas/decompose-result-envelope.schema.json\n.claude/skills/task-spec/references/authoring-workflow.md\n.claude/skills/task-spec/references/quick-reference.md\n.claude/skills/task-spec/.taskspec-version\ntests/fixtures/toolkit/blueprint.md\ntasks/.gitkeep\n","exit_code":0,"status":"completed"}}
