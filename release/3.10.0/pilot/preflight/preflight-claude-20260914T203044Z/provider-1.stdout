{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Gb2EUw81ouR8YgvRp3DNsZ","type":"tool_result","content":"#!/usr/bin/env bash\n# Canonical Task-Spec CLI. Stable commands; additive changes preserve exit codes.\nset -euo pipefail\n\n_ts_source=\"$0\"\nwhile [[ -h \"$_ts_source\" ]]; do\n  _ts_dir=\"$(cd -P \"$(dirname \"$_ts_source\")\" >/dev/null 2>&1 && pwd)\"\n  _ts_source=\"$(readlink \"$_ts_source\")\"\n  [[ \"$_ts_source\" != /* ]] && _ts_source=\"$_ts_dir/$_ts_source\"\ndone\nTASKSPEC_HOME=\"$(cd -P \"$(dirname \"$_ts_source\")/..\" >/dev/null 2>&1 && pwd)\"\nexport TASKSPEC_HOME\nunset _ts_source _ts_dir\n\n_ts_usage() {\n  python3 \"$TASKSPEC_HOME/src/cli/registry.py\" help\n}\n\n_ts_command_help() {\n  python3 \"$TASKSPEC_HOME/src/cli/registry.py\" help \"$@\"\n}\n\n_ts_doctor() {\n  local fails=0 common=\"\" key=\"\" next=\"\"\n  if [[ \"${BASH_VERSINFO[0]:-0}\" -gt 3 || ( \"${BASH_VERSINFO[0]:-0}\" -eq 3 && \"${BASH_VERSINFO[1]:-0}\" -ge 2 ) ]]; then\n    echo \"PASS  bash >= 3.2 (${BASH_VERSION})\"\n  else echo \"FAIL  bash >= 3.2 required\"; fails=$((fails + 1)); fi\n  if command -v git >/dev/null 2>&1; then echo \"PASS  git ($(git --version | awk '{print $3}'))\"; else echo \"FAIL  git missing\"; fails=$((fails + 1)); fi\n  if command -v python3 >/dev/null 2>&1; then echo \"PASS  python3 ($(python3 --version 2>&1 | awk '{print $2}'))\"; else echo \"FAIL  python3 missing\"; fails=$((fails + 1)); fi\n  if command -v openssl >/dev/null 2>&1 || command -v shasum >/dev/null 2>&1 || command -v sha256sum >/dev/null 2>&1; then echo \"PASS  SHA-256/HMAC provider\"; else echo \"WARN  no SHA-256 provider; sign-off degrades to Tier 2\"; fi\n  if command -v shellcheck >/dev/null 2>&1; then echo \"PASS  shellcheck\"; else\n    echo \"FAIL  shellcheck missing; required by PRE-gate\"\n    fails=$((fails + 1))\n    next=\"install shellcheck, then re-run: taskspec doctor\"\n  fi\n  if [[ -n \"${TASKSPEC_SIGNING_KEY:-}\" ]]; then key=\"environment\"; else\n    common=\"$(git rev-parse --git-common-dir 2>/dev/null || true)\"\n    if [[ -n \"$common\" && \"$common\" != /* ]]; then common=\"$(cd \"$common\" 2>/dev/null && pwd || true)\"; fi\n    [[ -n \"$common\" && -r \"$common/info/taskspec-signing-key\" ]] && key=\"$common/info/taskspec-signing-key\"\n  fi\n  if [[ -n \"$key\" ]]; then echo \"PASS  signing key ($key)\"; else echo \"WARN  no signing key; run: taskspec setup signing\"; fi\n  [[ -f \"$TASKSPEC_HOME/src/lib/_lib.sh\" ]] || { echo \"FAIL  invalid TASKSPEC_HOME=$TASKSPEC_HOME\"; fails=$((fails + 1)); }\n  if [[ \"$fails\" -eq 0 ]]; then\n    echo \"DOCTOR=READY\"\n  else\n    echo \"DOCTOR=BLOCKED\"\n    echo \"NEXT: ${next:-fix the FAIL lines above}\"\n  fi\n  return \"$fails\"\n}\n\n_ts_completion() {\n  python3 \"$TASKSPEC_HOME/src/cli/registry.py\" completion \"$@\"\n}\n\n_ts_has_arg() {\n  local wanted=\"$1\"; shift\n  local arg\n  for arg in \"$@\"; do [[ \"$arg\" == \"$wanted\" ]] && return 0; done\n  return 1\n}\n\n_ts_dispatch() {\n  local cmd=\"${1:-}\" script=\"\"\n  [[ -n \"$cmd\" ]] || { _ts_usage; return 2; }\n  shift || true\n  if [[ \"$cmd\" != \"help\" && ( \"${1:-}\" == \"--help\" || \"${1:-}\" == \"-h\" ) ]]; then\n    _ts_command_help \"$cmd\"\n    return $?\n  fi\n  case \"$cmd\" in\n    help)\n      if [[ -n \"${1:-}\" ]]; then\n        _ts_command_help \"$@\"; return $?\n      fi\n      _ts_usage; return 0 ;;\n    --help|-h) _ts_usage; return 0 ;;\n    version|--version) cat \"$TASKSPEC_HOME/VERSION\"; return 0 ;;\n    doctor)\n      if [[ \"${1:-}\" == \"--backlog\" ]]; then shift; python3 \"$TASKSPEC_HOME/src/setup/backlog_doctor.py\" \"$@\"; return $?; fi\n      [[ $# -eq 0 ]] || { echo \"taskspec doctor: unknown argument: $1\" >&2; return 2; }\n      _ts_doctor; return $? ;;\n    demo) bash \"$TASKSPEC_HOME/src/setup/demo.sh\" \"$@\"; return $? ;;\n    decompose) bash \"$TASKSPEC_HOME/src/decompose/launch.sh\" \"$@\"; return $? ;;\n    guide) python3 \"$TASKSPEC_HOME/src/cli/guide.py\" \"$@\"; return $? ;;\n    recipe) python3 \"$TASKSPEC_HOME/src/recipe/recipes.py\" \"$@\"; return $? ;;\n    example) python3 \"$TASKSPEC_HOME/src/author/examples.py\" \"$@\"; return $? ;;\n    completion) _ts_completion \"$@\"; return $? ;;\n    agent-context) python3 \"$TASKSPEC_HOME/src/dispatch/agent-context.py\"; return $? ;;\n    author-doctor) python3 \"$TASKSPEC_HOME/src/author/doctor.py\" \"$@\"; return $? ;;\n    holdout)\n      if [[ \"${TASKSPEC_DRY_RUN:-0}\" == \"1\" && \"${1:-}\" != \"verify\" ]]; then echo \"DRY_RUN: would run taskspec holdout $*\"; return 0; fi\n      python3 \"$TASKSPEC_HOME/src/evidence/holdout.py\" \"$@\"; return $? ;;\n    receipt)\n      if [[ \"${1:-}\" == \"operational\" ]]; then shift; python3 \"$TASKSPEC_HOME/src/evidence/operational.py\" \"$@\"; return $?; fi\n      if [[ \"${TASKSPEC_DRY_RUN:-0}\" == \"1\" && \"${1:-}\" != \"validate\" ]]; then echo \"DRY_RUN: would run taskspec receipt $*\"; return 0; fi\n      python3 \"$TASKSPEC_HOME/src/evidence/receipts.py\" \"$@\"; return $? ;;\n    eval-audit)\n      if [[ \"${TASKSPEC_DRY_RUN:-0}\" == \"1\" ]]; then echo \"DRY_RUN: would run taskspec eval-audit $*\"; return 0; fi\n      python3 \"$TASKSPEC_HOME/src/evidence/eval_audit.py\" \"$@\"; return $? ;;\n    identity)\n      if [[ \"${TASKSPEC_DRY_RUN:-0}\" == \"1\" && \"${1:-}\" != \"verify\" ]]; then echo \"DRY_RUN: would run taskspec identity $*\"; return 0; fi\n      python3 \"$TASKSPEC_HOME/src/security/identity.py\" \"$@\"; return $? ;;\n    evidence)\n      if [[ \"${TASKSPEC_DRY_RUN:-0}\" == \"1\" && \"${1:-}\" == \"run\" ]]; then echo \"DRY_RUN: would run taskspec evidence $*\"; return 0; fi\n      python3 \"$TASKSPEC_HOME/src/evidence/engine_matrix.py\" \"$@\"; return $? ;;\n    bridge)\n      if [[ \"${TASKSPEC_DRY_RUN:-0}\" == \"1\" && \"${1:-}\" == \"export\" ]] && _ts_has_arg --out \"$@\"; then echo \"DRY_RUN: would run taskspec bridge $*\"; return 0; fi\n      python3 \"$TASKSPEC_HOME/src/interop/bridge.py\" \"$@\"; return $? ;;\n    dsse)\n      if [[ \"${TASKSPEC_DRY_RUN:-0}\" == \"1\" && \"${1:-}\" == \"export\" ]]; then echo \"DRY_RUN: would run taskspec dsse $*\"; return 0; fi\n      python3 \"$TASKSPEC_HOME/src/interop/dsse.py\" \"$@\"; return $? ;;\n    mcp) python3 \"$TASKSPEC_HOME/src/interop/toolkit_mcp.py\" \"$@\"; return $? ;;\n    mesh) python3 \"$TASKSPEC_HOME/src/meshctl/cli.py\" \"$@\"; return $? ;;\n    init) script=\"src/setup/init.sh\" ;;\n    setup)\n      if [[ \"${1:-}\" == \"decompose\" ]]; then shift; python3 \"$TASKSPEC_HOME/src/setup/decompose.py\" \"$@\"; return $?; fi\n      if [[ \"${1:-}\" == \"signing\" ]]; then\n        shift\n        if [[ \"${TASKSPEC_DRY_RUN:-0}\" == \"1\" ]]; then echo \"DRY_RUN: provision repository signing key\"; return 0; fi\n        bash \"$TASKSPEC_HOME/tools/setup-taskspec-signing-key.sh\" \"$@\"; return $?\n      fi\n      script=\"src/setup/readiness.sh\"\n      ;;\n    plan)\n      [[ \"${TASKSPEC_JSON_MODE:-0}\" == \"1\" ]] && set -- --json \"$@\"\n      python3 \"$TASKSPEC_HOME/src/author/taskplan.py\" preview \"$@\"; return $? ;;\n    batch)\n      if [[ \"${1:-}\" == \"--plan\" ]]; then\n        local manifest=\"${2:-}\"; shift 2 || true\n        [[ -n \"$manifest\" ]] || { echo \"taskspec batch --plan requires a manifest\" >&2; return 2; }\n        if [[ \"${TASKSPEC_DRY_RUN:-0}\" == \"1\" ]]; then set -- --dry-run \"$@\"; fi\n        if [[ \"${TASKSPEC_JSON_MODE:-0}\" == \"1\" ]]; then set -- --json \"$@\"; fi\n        python3 \"$TASKSPEC_HOME/src/author/taskplan.py\" generate --manifest \"$manifest\" \"$@\"; return $?\n      fi\n      script=\"src/author/batch-generate.sh\"\n      [[ \"${TASKSPEC_DRY_RUN:-0}\" == \"1\" ]] && set -- --dry-run \"$@\"\n      ;;\n    handoff) python3 \"$TASKSPEC_HOME/src/dispatch/handoff.py\" \"$@\"; return $? ;;\n    dod) script=\"src/gate/definition-of-done.sh\" ;;","is_error":false}]},"parent_tool_use_id":null,"session_id":"77455642-14bb-4183-bcc7-b8eb152