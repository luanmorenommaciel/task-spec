{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011FbUecGTJycMPNmexBwioN","type":"tool_result","content":" M src/recipe/recipes.py\n?? .taskspec/handoffs/\n=== diff ===\ndiff --git a/src/recipe/recipes.py b/src/recipe/recipes.py\nindex 6bc846a..87f98af 100644\n--- a/src/recipe/recipes.py\n+++ b/src/recipe/recipes.py\n@@ -13,6 +13,7 @@ import sys\n ROOT = Path(__file__).resolve().parents[2]\n sys.path.insert(0, str(ROOT / \"src/lib\"))\n from taskspec_data import DataError, load_document, parse_yaml_subset  # noqa: E402\n+from taskspec_data import _json_object, _reject_json_constant  # noqa: E402\n \n CONTRACT = \"TaskExecutionRecipe/v1\"\n STRATEGIES = {\n@@ -87,12 +88,26 @@ def from_spec(text: str) -> tuple[dict | None, dict]:\n     return card.get(\"agent_contract\", {}).get(\"execution_recipe\"), card\n \n \n+def load_input(source: str) -> object:\n+    if source != \"-\":\n+        return load_document(source)\n+    text = sys.stdin.read()\n+    if not text.strip():\n+        raise DataError(\"no recipe on standard input; pipe a JSON or YAML document to recipe validate -\")\n+    # Standard input must parse exactly as strictly as load_document does for a\n+    # file: duplicate keys and ambiguous JSON constants stay rejected.\n+    try:\n+        return json.loads(text, object_pairs_hook=_json_object, parse_constant=_reject_json_constant)\n+    except json.JSONDecodeError:\n+        return parse_yaml_subset(text)\n+\n+\n def main() -> int:\n     parser = argparse.ArgumentParser(description=__doc__)\n     sub = parser.add_subparsers(dest=\"action\", required=True)\n     sub.add_parser(\"list\")\n     show = sub.add_parser(\"show\"); show.add_argument(\"strategy\", choices=sorted(STRATEGIES))\n-    check = sub.add_parser(\"validate\"); check.add_argument(\"file\"); check.add_argument(\"--budget\", type=int, default=15)\n+    check = sub.add_parser(\"validate\"); check.add_argument(\"file\", help=\"recipe document, or - to read standard input\"); check.add_argument(\"--budget\", type=int, default=15)\n     args = parser.parse_args()\n     try:\n         if args.action == \"list\":\n@@ -100,7 +115,7 @@ def main() -> int:\n         elif args.action == \"show\":\n             data = resolve(args.strategy, [\"eval_1\"])\n         else:\n-            data = load_document(args.file)\n+            data = load_input(args.file)\n             errors = validate(data, data.get(\"eval_ids\", []) if isinstance(data, dict) else [], args.budget)\n             if errors:\n                 raise DataError(\"; \".join(errors))","is_error":false}]},"parent_tool_use_id":null,"session_id":"77455642-14bb-4183-bcc7-b8eb1521612f","uuid":"05455c13-dfbf-4a91-9d79-3cf41a94b6ac","timestamp":"2026-09-14T20:34:15.387Z","tool_use_result":{"stdout":" M src/recipe/recipes.py\n?? .taskspec/handoffs/\n=== diff ===\ndiff --git a/src/recipe/recipes.py b/src/recipe/recipes.py\nindex 6bc846a..87f98af 100644\n--- a/src/recipe/recipes.py\n+++ b/src/recipe/recipes.py\n@@ -13,6 +13,7 @@ import sys\n ROOT = Path(__file__).resolve().parents[2]\n sys.path.insert(0, str(ROOT / \"src/lib\"))\n from taskspec_data import DataError, load_document, parse_yaml_subset  # noqa: E402\n+from taskspec_data import _json_object, _reject_json_constant  # noqa: E402\n \n CONTRACT = \"TaskExecutionRecipe/v1\"\n STRATEGIES = {\n@@ -87,12 +88,26 @@ def from_spec(text: str) -> tuple[dict | None, dict]:\n     return card.get(\"agent_contract\", {}).get(\"execution_recipe\"), card\n \n \n+def load_input(source: str) -> object:\n+    if source != \"-\":\n+        return load_document(source)\n+    text = sys.stdin.read()\n+    if not text.strip():\n+        raise DataError(\"no recipe on standard input; pipe a JSON or YAML document to recipe validate -\")\n+    # Standard input must parse exactly as strictly as load_document does for a\n+    # file: duplicate keys and ambiguous JSON constants stay rejected.\n+    try:\n+        return json.loads(text, object_pairs_hook=