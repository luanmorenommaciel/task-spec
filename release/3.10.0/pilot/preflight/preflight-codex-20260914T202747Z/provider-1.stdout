       *) sig_verify_version=invalid ;;\nsrc/gate/safe-to-delegate.sh:268:      if [[ \"$sig_verify_version\" == invalid ]]; then\nsrc/gate/safe-to-delegate.sh:271:        expected_sig=\"$(ts_compute_signoff_sig \"$FILE\" \"$key_now\" \"$sig_verify_version\")\"\nsrc/gate/safe-to-delegate.sh:274:      if [[ \"$sig_verify_version\" == v3 && -n \"$expected_sig\" && \"$expected_sig\" == \"$sig_now\" ]]; then\nsrc/gate/safe-to-delegate.sh:277:      elif [[ \"$sig_verify_version\" != invalid && -n \"$expected_sig\" && \"$expected_sig\" == \"$sig_now\" ]]; then\nsrc/gate/safe-to-delegate.sh:279:        echo \"   ${YELLOW}sign-off: legacy envelope ${sig_verify_version} (Tier 2)${RESET} — authentic but narrow; supervised dispatch only\"\nsrc/gate/validate-runtime.py:20:    from provenance import verify_task\nsrc/gate/validate-runtime.py:33:        try: verify_task(resolve_workspace(path),str(fm.get(\"id\")),fm[\"provenance\"])\nsrc/gate/validate-task-spec.sh:333:# Criteria + Exit Check. That is the irreducible self-verifying unit.\nsrc/gate/validate-task-spec.sh:343:  # the irreducible self-verifying unit for low-blast-radius S work; it earns its\nsrc/gate/validate-task-spec.sh:597:# has one parser shared with handoff/receipts rather than fragile grep rules.\nsrc/gate/validate-task-spec.sh:620:# Validation, readiness, handoff, status, and acceptance share the same graph\n","exit_code":0,"status":"completed"}}
