{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taskspec.dev/schema/credential-lease.schema.json",
  "title": "CredentialLease/v1",
  "description": "Metadata for an attempt-scoped capability. The credential value is deliberately never serializable in this contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "lease_id", "attempt_id", "provider", "model", "audience", "scopes", "issued_at", "expires_at", "state"],
  "properties": {
    "contract": {"const": "CredentialLease/v1"},
    "lease_id": {"type": "string", "format": "uuid"},
    "attempt_id": {"type": "string", "format": "uuid"},
    "provider": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "audience": {"type": "string", "minLength": 1},
    "scopes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "state": {"enum": ["issued", "active", "expired", "revoked"]},
    "broker_ref": {"type": ["string", "null"]}
  }
}
