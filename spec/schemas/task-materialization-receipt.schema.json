{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taskspec.dev/schema/v1/task-materialization-receipt.schema.json",
  "title": "TaskMaterializationReceipt v1",
  "description": "Deterministic receipt for materializing an approved TaskPlan. It proves generated bytes and never grants dispatch authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "engine_version",
    "input",
    "output_dir",
    "dry_run",
    "materialized",
    "changed",
    "state",
    "dispatch_authorized",
    "tasks",
    "warnings"
  ],
  "properties": {
    "contract": {"const": "TaskMaterializationReceipt/v1"},
    "engine_version": {"type": "string", "minLength": 1},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "manifest", "digest", "approved"],
      "properties": {
        "contract": {"const": "TaskPlan/v1"},
        "manifest": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "approved": {"const": true}
      }
    },
    "output_dir": {"type": "string", "minLength": 1},
    "dry_run": {"type": "boolean"},
    "materialized": {"type": "boolean"},
    "changed": {"type": "boolean"},
    "state": {"enum": ["dry_run", "created", "unchanged"]},
    "dispatch_authorized": {"const": false},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "path", "sha256"],
        "properties": {
          "task_id": {"type": "string", "pattern": "^T-[0-9]{8}-[a-z0-9][a-z0-9-]*$"},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"dry_run": {"const": true}}},
      "then": {
        "properties": {
          "materialized": {"const": false},
          "changed": {"const": false},
          "state": {"const": "dry_run"}
        }
      },
      "else": {"properties": {"materialized": {"const": true}}}
    },
    {
      "if": {"properties": {"state": {"const": "created"}}},
      "then": {"properties": {"changed": {"const": true}}},
      "else": {"properties": {"changed": {"const": false}}}
    }
  ]
}
