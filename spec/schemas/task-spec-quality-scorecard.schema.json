{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taskspec.dev/schema/task-spec-quality-scorecard.schema.json",
  "title": "TaskSpecQualityScorecard/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "release_version", "rubric_digest", "generated_at", "dimensions", "total"],
  "properties": {
    "contract": {"const": "TaskSpecQualityScorecard/v1"},
    "release_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
    "rubric_digest": {"$ref": "#/$defs/digest"},
    "generated_at": {"type": "string", "format": "date-time"},
    "dimensions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/dimension"}},
    "total": {
      "type": "object",
      "additionalProperties": false,
      "required": ["awarded", "maximum", "target", "passed"],
      "properties": {
        "awarded": {"type": "integer", "minimum": 0},
        "maximum": {"type": "integer", "minimum": 1},
        "target": {"type": "integer", "minimum": 1},
        "passed": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest", "class", "state"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
        "digest": {"$ref": "#/$defs/digest"},
        "class": {"enum": ["local", "hosted", "published", "external_engine", "external_enforcement", "protocol", "provenance"]},
        "state": {"enum": ["pass", "fail", "pending", "not_run", "unavailable"]}
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "points", "awarded", "state", "evidence", "reason"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "points": {"type": "integer", "minimum": 1},
        "awarded": {"type": "integer", "minimum": 0},
        "state": {"enum": ["pass", "fail", "pending", "not_run", "unavailable"]},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "awarded_points", "max_points", "criteria"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "awarded_points": {"type": "integer", "minimum": 0},
        "max_points": {"type": "integer", "minimum": 1},
        "criteria": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/criterion"}}
      }
    }
  }
}
