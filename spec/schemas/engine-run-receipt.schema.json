{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://taskspec.dev/schema/v4/engine-run-receipt.schema.json",
  "title": "EngineRunReceipt v1", "type": "object", "additionalProperties": false,
  "required": ["contract", "run_id", "task_id", "task_digest", "handoff_digest", "source_commit", "provider", "model_id", "adapter_version", "engine_version", "environment_digest", "started_at", "finished_at", "attempts", "terminal_outcome", "acceptance_verdict", "artifacts", "deviations"],
  "properties": {"contract": {"const": "EngineRunReceipt/v1"}, "run_id": {"type": "string"}, "task_id": {"type": "string"}, "task_digest": {"type": "string"}, "handoff_digest": {"type": "string"}, "source_commit": {"type": "string"}, "provider": {"type": "string"}, "model_id": {"type": "string"}, "adapter_version": {"type": "string"}, "engine_version": {"type": "string"}, "environment_digest": {"type": "string"}, "started_at": {"type": "string"}, "finished_at": {"type": "string"}, "attempts": {"type": "integer", "minimum": 0}, "terminal_outcome": {"enum": ["pass", "fail", "parked", "blocked", "unavailable", "error"]}, "acceptance_verdict": {"enum": ["accepted", "rejected", "not_run"]}, "artifacts": {"type": "array", "items": {"type": "string"}}, "deviations": {"type": "array", "items": {"type": "string"}}}
