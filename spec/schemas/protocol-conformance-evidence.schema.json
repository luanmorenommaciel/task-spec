{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taskspec.dev/schema/protocol-conformance-evidence.schema.json",
  "title": "ProtocolConformanceEvidence/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "protocol", "specification_version", "sdk", "observed_at", "result", "scenarios", "artifacts"],
  "properties": {
    "contract": {"const": "ProtocolConformanceEvidence/v1"},
    "protocol": {"enum": ["A2A", "MCP"]},
    "specification_version": {"type": "string", "minLength": 1},
    "sdk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "source_revision", "source_digest"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "source_revision": {"type": "string", "minLength": 1},
        "source_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "observed_at": {"type": "string", "format": "date-time"},
    "result": {"enum": ["pass", "fail", "unavailable"]},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "description"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "fail", "not_run"]},
          "description": {"type": "string", "minLength": 1}
        }
      }
    },
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
