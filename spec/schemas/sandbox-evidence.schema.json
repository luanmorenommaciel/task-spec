{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taskspec.dev/schema/sandbox-evidence.schema.json",
  "title": "SandboxEvidence/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "subject", "runtime", "image_digest", "attestation", "verified", "observed_at"],
  "properties": {
    "contract": {"const": "SandboxEvidence/v1"},
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["task_id", "task_revision_digest", "authorization_ref", "attempt_id", "base_commit"],
      "properties": {
        "task_id": {"type": "string"},
        "task_revision_digest": {"$ref": "#/$defs/digest"},
        "authorization_ref": {"type": "string", "pattern": "^hmac-sha256-v3:"},
        "attempt_id": {"type": "string", "format": "uuid"},
        "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}
      }
    },
    "runtime": {"enum": ["docker", "podman"]},
    "image_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "attestation": {
      "type": "object", "additionalProperties": false, "required": ["path", "digest", "signature_ref"],
      "properties": {"path": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}, "signature_ref": {"type": "string", "minLength": 1}}
    },
    "verified": {"type": "boolean"},
    "observed_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {"digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
