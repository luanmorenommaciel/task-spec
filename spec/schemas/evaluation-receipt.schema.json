{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://taskspec.dev/schema/v4/evaluation-receipt.schema.json",
  "title": "EvaluationReceipt v1", "type": "object", "additionalProperties": false,
  "required": ["contract", "task_id", "check_type", "authorization_ref", "evaluator", "evaluated_at", "result", "evidence"],
  "properties": {"contract": {"const": "EvaluationReceipt/v1"}, "task_id": {"type": "string"}, "check_type": {"enum": ["deterministic", "holdout"]}, "authorization_ref": {"type": "string"}, "descriptor_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "evaluator": {"type": "string"}, "evaluated_at": {"type": "string", "format": "date-time"}, "result": {"enum": ["pass", "fail", "error"]}, "evidence": {"type": "array"}}
}
