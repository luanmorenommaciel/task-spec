{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taskspec.dev/schema/task-execution-recipe.schema.json",
  "title": "TaskExecutionRecipe/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "strategy",
    "strategy_version",
    "steps",
    "context",
    "artifacts",
    "eval_ids",
    "max_rounds",
    "no_progress_rounds",
    "stop_on",
    "on_failure",
    "runner",
    "required_capabilities"
  ],
  "properties": {
    "contract": {
      "const": "TaskExecutionRecipe/v1"
    },
    "strategy": {
      "type": "string",
      "minLength": 1
    },
    "strategy_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "context": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "eval_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "max_rounds": {
      "type": "integer",
      "minimum": 1
    },
    "no_progress_rounds": {
      "type": "integer",
      "minimum": 1
    },
    "stop_on": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "on_failure": {
      "const": "park_with_context"
    },
    "runner": {
      "const": "taskmesh"
    },
    "required_capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
